<%- include('../partials/head') %>
<div class="card" style="max-width:560px;margin:20px auto">
  <img src="/logo.png" alt="" width="80" height="80" style="display:block;margin:0 auto 8px;border-radius:50%">
  <h1 style="text-align:center"><%= t('Join your family on the {org} app', { org: t.data(orgName) }) %></h1>
  <p style="text-align:center"><%= t('{owner} invited {name} to have their own login, covered by the family membership.', { owner: `${invite.owner_first} ${invite.owner_last}`, name: invite.name }) %></p>

  <% if (user) { %>
    <% if (problem) { %>
      <p class="flash info"><%= t(problem, { name: invite.name }) %></p>
      <p class="small"><%= t('Is this {name} on a shared phone or computer? Sign out first, then create their login.', { name: invite.name }) %></p>
      <form method="post" action="/join/family/<%= token %>/switch"><%- include('../partials/csrf') %>
        <button class="btn big secondary"><%= t("Sign out and create {name}'s login", { name: invite.name }) %></button></form>
    <% } else { %>
      <p><%= t("You're signed in as {name}. Join {owner}'s family with this account?", { name: `${user.first_name} ${user.last_name}`, owner: invite.owner_first }) %></p>
      <form method="post" action="/join/family/<%= token %>/link"><%- include('../partials/csrf') %>
        <button class="btn big"><%= t('Join the family') %></button></form>
    <% } %>
  <% } else { %>
    <p class="muted small"><%= t('Create your login below. Use your own email and a password only you know.') %></p>
    <form method="post" action="/join/family/<%= token %>" class="stack">
      <%- include('../partials/csrf') %>
      <%# The family's address and native place, and the birth month and year on the family list, are filled in already. %>
      <%- include('../partials/profile-fields', { p: form, required: true, email: true }) %>
      <div class="fields">
        <label><span><%= t('Password (at least 8 characters)') %> <span class="req" aria-hidden="true">*</span></span> <input type="password" name="password" minlength="8" required autocomplete="new-password"></label>
        <label><span><%= t('Confirm password') %> <span class="req" aria-hidden="true">*</span></span> <input type="password" name="password_confirm" minlength="8" required autocomplete="new-password"></label>
      </div>
      <button class="btn big"><%= t('Create my login') %></button>
    </form>
    <p class="muted small"><%= t('Already have a GSA login?') %> <a href="/login"><%= t('Sign in') %></a> — <%= t("you'll come back to this page.") %></p>
  <% } %>
</div>
<%- include('../partials/foot') %>
