<%- include('../partials/head') %>
<%# After signing in with a password that has to be replaced (too weak for today's rules, or a temporary one
    from a committee member). Every other page sends them here until it's done. %>
<div class="card auth-card" style="max-width:520px;margin:20px auto">
  <h1><%= t('Choose a new password') %></h1>
  <p><%= user.password_temporary
    ? t('You signed in with a temporary password from a committee member. Please choose your own password to continue.')
    : t('To keep your account and your family’s details safe, GSA now asks for stronger passwords. Please choose a new one to continue.') %></p>
  <form method="post" action="/password/new" class="stack">
    <%- include('../partials/csrf') %>
    <%- include('../partials/password-fields', { min: passwordMin, label: t('New password'), confirmLabel: t('Confirm new password') }) %>
    <button class="btn big"><%= t('Save new password') %></button>
  </form>
  <form method="post" action="/logout" style="margin-top:12px"><%- include('../partials/csrf') %><button class="linkish"><%= t('Sign out') %></button></form>
</div>
<%- include('../partials/foot') %>
