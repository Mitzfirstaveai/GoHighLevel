<%- include('../partials/head') %>
<div class="card" style="max-width:460px;margin:20px auto">
  <img src="/logo.png" alt="" width="80" height="80" style="display:block;margin:0 auto 8px;border-radius:50%">
  <h1 style="text-align:center"><%= t('Committee & volunteer sign-in') %></h1>
  <p style="text-align:center"><%= t('Only for committee members, and for volunteers the committee has given door access. Volunteers go straight to door check-in.') %></p>
  <p class="muted small" style="text-align:center"><%= t('Members: please use the member sign-in.') %> <a href="/login"><%= t('Member sign-in') %></a></p>
  <% if (user && !doorMode) { %>
    <p class="flash info"><%= t("You're signed in to the member app as {name}. Signing in here switches to your committee or volunteer account.", { name: `${user.first_name} ${user.last_name}` }) %></p>
  <% } %>
  <form method="post" action="/admin/login" class="stack">
    <%- include('../partials/csrf') %>
    <label><%= t('Email') %> <input type="email" name="email" value="<%= email %>" required autocomplete="email"></label>
    <label><%= t('Password') %> <input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn big"><%= t('Sign in') %></button>
  </form>
  <% const staffDemo = demoAccounts.filter((a) => a.staff); %>
  <% if (staffDemo.length) { %>
    <div class="demo-login">
      <p class="small" style="margin:0 0 8px"><strong><%= t('Demo site') %></strong> — <%= t('tap to sign in as:') %></p>
      <div class="actions">
      <% for (const a of staffDemo) { %>
        <form method="post" action="/admin/login"><%- include('../partials/csrf') %>
          <input type="hidden" name="email" value="<%= a.email %>"><input type="hidden" name="password" value="<%= demoPassword %>">
          <button class="btn secondary small" lang="en"><%= a.label %></button></form>
      <% } %>
      </div>
    </div>
  <% } %>
  <p class="muted small"><%= t('Not on the committee?') %> <a href="/login"><%= t('Member sign-in') %></a>. <%= t('Forgot your password? Ask a committee member to reset it.') %></p>
</div>
<%- include('../partials/foot') %>
