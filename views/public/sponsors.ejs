<%- include('../partials/head') %>
<%- include('../partials/about-tabs') %>
<h1><%= t('Our Sponsors') %></h1>
<p class="muted"><%= t('Thank you to the businesses who support the {org}.', { org: t.data(orgName) }) %></p>
<% for (const s of sponsors) { %>
  <div class="card">
    <h2><span class="tier tier-<%= s.tier.toLowerCase().replace(/\s+/g, '-') %>"><%= t.data(s.tier) %></span><% if (s.tier !== 'Sponsors' && s.tier !== 'Community partner') { %> <%= t('Level') %><% } %></h2>
    <div class="sponsor-grid">
      <% for (const sp of s.sponsors) { %>
        <% if (sp.website) { %><a class="sponsor" href="<%= sp.website %>" target="_blank" rel="noopener noreferrer"><%= sp.name %></a>
        <% } else { %><div class="sponsor"><%= sp.name %></div><% } %>
      <% } %>
    </div>
  </div>
<% } %>
<div class="card">
  <h2><%= t('Become a sponsor') %></h2>
  <p class="muted"><%= t('Interested in supporting GSA? Contact us:') %> <a href="mailto:<%= org.email %>"><%= org.email %></a> · <a href="tel:<%= org.phone.replace(/\D/g, '') %>"><%= org.phone %></a></p>
</div>
<%- include('../partials/foot') %>
