<%# A new password and its confirmation, with the rules as a checklist that ticks itself while typing
    (app.js) and a show/hide button. The server checks the same rules, plus common passwords and the
    person's own name or email. min: 10 for members, 12 for committee members and door volunteers. %>
<% const min = locals.min || 10;
   const field = locals.field || 'password';
   const confirmField = locals.confirmField || 'password_confirm'; %>
<div class="password-fields stack" data-password-rules>
  <label><span><%= locals.label || t('Password') %> <span class="req" aria-hidden="true">*</span></span>
    <span class="pw-wrap">
      <input type="password" name="<%= field %>" minlength="<%= min %>" maxlength="64" required autocomplete="new-password" data-password data-min="<%= min %>" aria-describedby="<%= field %>-rules">
      <button type="button" class="pw-toggle" data-pw-toggle aria-pressed="false" data-show="<%= t('Show') %>" data-hide="<%= t('Hide') %>"><%= t('Show') %></button>
    </span>
  </label>
  <ul class="pw-rules small" id="<%= field %>-rules">
    <li data-rule="length"><%= t('At least {n} characters', { n: min }) %></li>
    <li data-rule="upper"><%= t('An uppercase letter (A–Z)') %></li>
    <li data-rule="lower"><%= t('A lowercase letter (a–z)') %></li>
    <li data-rule="number"><%= t('A number (0–9)') %></li>
    <li data-rule="symbol"><%= t('A symbol, like ! # $ @') %></li>
  </ul>
  <p class="muted small" style="margin:0"><%= t("Not a common password, and not your name or email. Tip: join a few words you'll remember with a number and a symbol.") %></p>
  <label><span><%= locals.confirmLabel || t('Confirm password') %> <span class="req" aria-hidden="true">*</span></span>
    <input type="password" name="<%= confirmField %>" minlength="<%= min %>" maxlength="64" required autocomplete="new-password" data-password-confirm>
  </label>
</div>
