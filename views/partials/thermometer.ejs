<% const pct = c.goal_cents ? Math.min(100, Math.round(c.progress.cents / c.goal_cents * 100)) : null; %>
<div class="small"><strong><%= money(c.progress.cents) %></strong> <%= c.goal_cents ? t('raised of {goal} goal', { goal: money(c.goal_cents) }) : t('raised') %> · <%= plural(c.progress.donors, '1 donor', '{n} donors') %></div>
<% if (pct !== null) { %><div class="meter" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= pct %>" aria-label="<%= t('{pct}% of goal', { pct }) %>"><span style="width:<%= pct %>%"></span></div><div class="muted small"><%= t('{pct}% of goal', { pct }) %></div><% } %>
