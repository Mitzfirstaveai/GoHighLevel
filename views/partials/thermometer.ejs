<% const pct = c.goal_cents ? Math.min(100, Math.round(c.progress.cents / c.goal_cents * 100)) : null; %>
<div class="small"><strong><%= money(c.progress.cents) %></strong> raised<%= c.goal_cents ? ` of ${money(c.goal_cents)} goal` : '' %> · <%= c.progress.donors %> donor<%= c.progress.donors === 1 ? '' : 's' %></div>
<% if (pct !== null) { %><div class="meter" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= pct %>" aria-label="<%= pct %>% of goal"><span style="width:<%= pct %>%"></span></div><div class="muted small"><%= pct %>% of goal</div><% } %>
