<!doctype html>
<html lang="<%= lang %>" class="size-<%= textSize %>"<% if (theme !== 'auto') { %> data-theme="<%= theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#E67817">
  <title><%= t.data(title) %> · <%= t.data(orgName) %></title>
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="GSA">
  <% if (lang === 'gu') { %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Gujarati:wght@400;600;700&display=swap">
  <% } %>
  <link rel="stylesheet" href="<%= asset('/styles.css') %>">
</head>
<%
  const active = (href, exact) => (exact ? path === href : path === href || path.startsWith(href + '/'));
  const memberTabs = [
    ['/dashboard', 'Home', 'home', true],
    ['/events', 'Events', 'calendar'],
    ['/tickets', 'My tickets', 'ticket'],
    ['/membership', 'Membership', 'card'],
    ['/donate', 'Donate', 'heart'],
    // Second row: personal first, then community, then information about GSA.
    ['/profile', 'Profile', 'user'],
    ['/photos', 'Photos', 'photo'],
    ['/news', 'News', 'news'],
    ['/directory', 'Directory', 'book'],
    ['/about', 'About GSA', 'info'],
  ];
  const aboutPaths = ['/about', '/committee', '/sponsors', '/contact'];
  // The admin area is for the committee and stays in English.
  const adminTabs = [
    ['/admin', 'Overview', 'shield', true],
    ['/admin/checkin', 'Check-in', 'scan'],
    ['/admin/events', 'Events', 'calendar'],
    ['/admin/members', 'Contacts', 'users'],
    ['/admin/payments', 'Payments', 'dollar'],
    ['/admin/donations', 'Donations', 'heart'],
    ['/admin/reports', 'Reports', 'chart'],
    ['/admin/insights', 'Trends', 'trend'],
    ['/admin/plans', 'Levels', 'list'],
    ['/admin/news', 'News', 'news'],
    ['/admin/photos', 'Photos', 'photo'],
    ['/admin/site', 'Website', 'edit'],
  ];
  const back = encodeURIComponent(url);
  const sizeLabels = { normal: 'Text size: normal', large: 'Text size: large', xlarge: 'Text size: extra large' };
%>
<body class="<%= user ? 'signed-in' : '' %><%= doorMode ? ' staff-mode door-mode' : adminMode ? ' staff-mode admin-mode' : '' %>">
<a class="skip" href="#main"><%= t('Skip to content') %></a>
<header class="topbar">
  <div class="inner">
    <a class="brand" href="<%= doorMode ? '/admin/checkin' : adminMode ? '/admin' : '/' %>">
      <img src="/logo.png" alt="" width="44" height="44">
      <span class="brand-full"><%= t.data(orgName) %></span><span class="brand-short"><%= org.shortName %></span>
    </a>
    <% if (doorMode) { %>
      <span class="door-label"><%- include('icon', { name: 'scan' }) %> <%= t('Door check-in') %></span>
    <% } else if (adminMode) { %>
      <span class="door-label" lang="en"><%- include('icon', { name: 'shield' }) %> Admin</span>
    <% } else if (!user) { %>
      <nav class="nav"><a href="/login"><%= t('Sign in') %></a><a href="/register" class="btn small"><%= t('Join') %></a></nav>
    <% } %>
    <div class="prefs">
      <a class="pref-btn lang-btn" href="/prefs?lang=<%= lang === 'gu' ? 'en' : 'gu' %>&back=<%= back %>" lang="<%= lang === 'gu' ? 'en' : 'gu' %>"
         title="<%= lang === 'gu' ? 'Read in English' : 'ગુજરાતીમાં વાંચો' %>"><%= lang === 'gu' ? 'English' : 'ગુજરાતી' %></a>
      <%# Light/dark: both buttons are sent and the stylesheet shows the one that switches away from the colors on screen
          (with no choice saved yet, that depends on the phone's own setting, which only the browser knows). %>
      <a class="pref-btn theme-btn to-dark" href="/prefs?theme=dark&back=<%= back %>" title="<%= t('Dark mode') %>" aria-label="<%= t('Dark mode') %>"><%- include('icon', { name: 'moon' }) %><span class="theme-word"><%= t('Dark') %></span></a>
      <a class="pref-btn theme-btn to-light" href="/prefs?theme=light&back=<%= back %>" title="<%= t('Light mode') %>" aria-label="<%= t('Light mode') %>"><%- include('icon', { name: 'sun' }) %><span class="theme-word"><%= t('Light') %></span></a>
      <a class="pref-btn size-btn" href="/prefs?size=next&back=<%= back %>" title="<%= t(sizeLabels[textSize]) %>" aria-label="<%= t(sizeLabels[textSize]) %> — <%= t('tap to change') %>">A<span class="size-plus"><%= textSize === 'normal' ? '+' : textSize === 'large' ? '++' : '−' %></span></a>
      <% if (doorMode || adminMode) { %>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="pref-btn"><%= t('Sign out') %></button></form>
      <% } else if (user) { %>
        <%# Worded, not just an icon: an arrow-and-door symbol means nothing to many members. %>
        <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="pref-btn"><%= t('Sign out') %></button></form>
      <% } %>
    </div>
  </div>
  <% if (!user) { %>
    <nav class="nav mainnav desktop-only" aria-label="<%= t('Main menu') %>">
      <div class="inner">
        <% for (const [href, label] of [['/about', 'About'], ['/committee', 'Committee'], ['/sponsors', 'Sponsors'], ['/contact', 'Contact']]) { %>
          <a href="<%= href %>" class="<%= path === href ? 'active' : '' %>"><%= t(label) %></a>
        <% } %>
      </div>
    </nav>
  <% } %>
  <div class="stripe" aria-hidden="true"></div>
</header>

<%# Main menus: a band of large buttons (icon above the label) under the header. Members get it on
    computers and tablets (phones use the bottom tab bar); the admin area gets it on every screen. %>
<% if (user && !doorMode && !adminMode) { %>
  <nav class="menu-band member-menu desktop-only" aria-label="<%= t('Main menu') %>">
    <div class="inner">
      <% for (const [href, label, icon, exact] of memberTabs) { %>
        <% const on = active(href, exact) || (href === '/about' && aboutPaths.includes(path)); %>
        <a href="<%= href %>" class="<%= on ? 'active' : '' %>"<%- on ? ' aria-current="page"' : '' %>><%- include('icon', { name: icon }) %><span><%= t(label) %></span></a>
      <% } %>
    </div>
  </nav>
  <%# The same menu as one slim row, pinned to the top once the big buttons scroll away (shown by app.js). %>
  <nav class="menu-compact desktop-only" aria-label="<%= t('Main menu') %>" data-compact-menu hidden>
    <div class="inner">
      <% for (const [href, label, icon, exact] of memberTabs) { %>
        <% const on = active(href, exact) || (href === '/about' && aboutPaths.includes(path)); %>
        <a href="<%= href %>" class="<%= on ? 'active' : '' %>"><%- include('icon', { name: icon }) %><%= t(label) %></a>
      <% } %>
    </div>
  </nav>
<% } %>
<% if (adminMode) { %>
  <nav class="subnav menu-band admin-menu" aria-label="Admin" lang="en">
    <div class="inner">
      <% for (const [href, label, icon, exact] of adminTabs) { %>
        <a href="<%= href %>" class="<%= active(href, exact) ? 'active' : '' %>"<%- active(href, exact) ? ' aria-current="page"' : '' %>><%- include('icon', { name: icon }) %><span><%= label %></span></a>
      <% } %>
    </div>
  </nav>
<% } %>

<% if (paymentMode === 'demo') { %><div class="demo-banner"><%= t('Demo payment mode — no real money is charged. Connect Stripe to accept card payments.') %></div><% } %>
<main id="main">
<% for (const f of flash) { %><div class="flash <%= f.type %>" role="<%= f.type === 'error' ? 'alert' : 'status' %>"><%= f.message %></div><% } %>
