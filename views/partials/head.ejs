<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#E67817">
  <title><%= title %> · <%= orgName %></title>
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="apple-touch-icon" href="/logo.png">
  <link rel="stylesheet" href="/styles.css">
</head>
<%
  const isAdmin = user && user.role === 'admin';
  const inAdmin = path.startsWith('/admin');
  const active = (href, exact) => (exact ? path === href : path === href || path.startsWith(href + '/'));
  const memberTabs = [
    ['/dashboard', 'Home', 'home', true],
    ['/events', 'Events', 'calendar'],
    ['/tickets', 'My tickets', 'ticket'],
    ['/membership', 'Membership', 'card'],
    ['/profile', 'Profile', 'user'],
  ];
  const adminTabs = [
    ['/admin', 'Overview', 'shield', true],
    ['/admin/checkin', 'Check-in', 'scan'],
    ['/admin/events', 'Events', 'calendar'],
    ['/admin/members', 'Members', 'users'],
    ['/admin/payments', 'Payments', 'dollar'],
    ['/admin/plans', 'Dues plans', 'list'],
  ];
%>
<body class="<%= user ? 'signed-in' : '' %>">
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <div class="inner">
    <a class="brand" href="/">
      <img src="/logo.png" alt="" width="44" height="44">
      <span><%= orgName %></span>
    </a>
    <% if (user) { %>
      <nav class="nav desktop-only" aria-label="Main">
        <% for (const [href, label, icon, exact] of memberTabs) { %>
          <a href="<%= href %>" class="<%= active(href, exact) ? 'active' : '' %>"><%= label %></a>
        <% } %>
        <% if (isAdmin) { %><a href="/admin" class="admin-link <%= inAdmin ? 'active' : '' %>"><%- include('icon', { name: 'shield' }) %> Admin</a><% } %>
      </nav>
      <form method="post" action="/logout" class="desktop-only"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkish" title="Sign out"><%- include('icon', { name: 'logout' }) %><span class="sr-only">Sign out</span></button></form>
    <% } else { %>
      <nav class="nav"><a href="/login">Sign in</a><a href="/register" class="btn small">Join</a></nav>
    <% } %>
  </div>
  <div class="stripe" aria-hidden="true"></div>
</header>

<% if (isAdmin && inAdmin) { %>
  <nav class="subnav" aria-label="Admin">
    <div class="inner">
      <% for (const [href, label, icon, exact] of adminTabs) { %>
        <a href="<%= href %>" class="<%= active(href, exact) ? 'active' : '' %>"><%- include('icon', { name: icon }) %><%= label %></a>
      <% } %>
    </div>
  </nav>
<% } %>

<% if (paymentMode === 'demo') { %><div class="demo-banner">Demo payment mode — no real money is charged. Connect Stripe to accept card payments.</div><% } %>
<main id="main">
<% for (const f of flash) { %><div class="flash <%= f.type %>" role="<%= f.type === 'error' ? 'alert' : 'status' %>"><%= f.message %></div><% } %>
