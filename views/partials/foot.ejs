</main>
<% if (user && !doorMode && !adminMode) { %>
<%
  const tabs = [
    ['/dashboard', 'Home', 'home', true],
    ['/events', 'Events', 'calendar'],
    ['/tickets', 'My tickets', 'ticket'],
    ['/membership', 'Membership', 'card'],
    ['/donate', 'Donate', 'heart'],
    ['/more', 'More', 'more'],
  ];
  // Same names as the top menu; everything else is under More.
  const moreSection = ['/more', '/profile', '/payments', '/directory', '/news', '/photos', '/about', '/committee', '/sponsors', '/contact'];
  const on = (href, exact) => (exact ? path === href : path === href || path.startsWith(href + '/'));
%>
<nav class="tabbar mobile-only" aria-label="<%= t('Main menu') %>">
  <% for (const [href, label, icon, exact] of tabs) { %>
    <a href="<%= href %>" class="<%= on(href, exact) || (href === '/more' && moreSection.some((m) => path === m || path.startsWith(m + '/'))) ? 'active' : '' %>"><%- include('icon', { name: icon }) %><span><%= t(label).replace(/^Membership$/, 'Member\u00ADship') %></span></a>
  <% } %>
</nav>
<% } else if (user && adminMode) { %>
<%# Phones: the admin bottom bar. "More" covers the admin pages not on the bar. %>
<nav class="tabbar mobile-only admin-tabbar" aria-label="Admin" lang="en">
  <% const onAdmin = (href, exact) => (exact ? path === href : path === href || path.startsWith(href + '/'));
     const inMore = ADMIN_MORE.some(([h]) => onAdmin(h)) || path === '/admin/more'; %>
  <% for (const [href, label, icon, exact] of ADMIN_BAR) { %>
    <a href="<%= href %>" class="<%= (href === '/admin/more' ? inMore : onAdmin(href, exact)) ? 'active' : '' %>"><%- include('icon', { name: icon }) %><span><%= label %></span></a>
  <% } %>
</nav>
<% } %>
<footer class="site-footer">
  <div class="footer-info">
    <img src="/logo.png" alt="" width="36" height="36" style="border-radius:50%"><br>
    <strong><%= t.data(orgName) %></strong> · “<%= loc(org, 'motto') %>”<br>
    <%= org.address.join(', ') %> · <a href="tel:<%= org.phone.replace(/\D/g, '') %>"><%= org.phone %></a> · <a href="mailto:<%= org.email %>"><%= org.email %></a><br>
    <a href="/about"><%= t('About') %></a> · <a href="/committee"><%= t('Committee') %></a> · <a href="/sponsors"><%= t('Sponsors') %></a> · <a href="/contact"><%= t('Contact') %></a><br>
    <% if (!user) { %><a href="/admin/login"><%= t('Committee & volunteer sign-in') %></a><br><% } %>
    <span class="small"><%= t('A 501(c)(3) nonprofit organization · Est. {year}', { year: org.founded }) %></span>
  </div>
</footer>
<script src="<%= asset('/app.js') %>" defer></script>
</body>
</html>
