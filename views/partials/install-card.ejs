<%# "Get the GSA app": on Home and on both sign-in pages, so people can install before signing in, and always
    on More (always: true, no ✕). app.js shows it (unless installed, or closed earlier in this visit) and fills in
    the steps for the device. %>
<% const alwaysShown = locals.always === true; %>
<div class="card install-card" id="install-card" hidden<% if (alwaysShown) { %> data-always<% } %><% if (typeof narrow !== 'undefined' && narrow) { %> style="max-width:460px;margin:20px auto 0"<% } %>>
  <img src="/icon-192.png" alt="" width="48" height="48">
  <div style="flex:1">
    <strong><%= t('Get the GSA app') %></strong>
    <div class="small muted"><%= typeof blurb !== 'undefined' ? blurb : t('Add it to your home screen — your QR tickets work even without signal.') %></div>
    <%# app.js shows the steps for this device when "Install" can't open the browser's own install prompt. %>
    <div class="small install-steps" data-steps="ios" hidden><%= t('On iPhone or iPad: tap the Share button (square with an arrow), then "Add to Home Screen".') %></div>
    <div class="small install-steps" data-steps="mac" hidden><%= t('In Safari on a Mac: choose File, then "Add to Dock".') %></div>
    <div class="small install-steps" data-steps="other" hidden><%= t('Open your browser menu (⋮ or ⋯) and choose "Install app" or "Add to Home screen".') %> <%= t('This does not work in a private or incognito window.') %></div>
  </div>
  <button class="btn small" data-install><%= t('Install') %></button>
  <% if (!alwaysShown) { %><button class="linkish" data-dismiss aria-label="<%= t('Dismiss') %>">✕</button><% } %>
</div>
