<% if (status === 'confirmed') { %><span class="badge ok"><%= t('Confirmed') %></span>
<% } else if (status === 'pending_payment') { %><span class="badge warn"><%= t('Payment due') %></span>
<% } else if (status === 'waitlisted') { %><span class="badge tag"><%= t('Waitlist') %></span>
<% } else if (status === 'cancelled') { %><span class="badge neutral"><%= t('Cancelled') %></span>
<% } %>
