<%- include('partials/head') %>
<section class="hero">
  <img src="/logo.png" alt="">
  <h1><%= t('Welcome to {org}', { org: t.data(orgName) }) %></h1>
  <p class="motto">“<%= loc(org, 'motto') %>”</p>
  <p class="muted" style="max-width:640px;margin:12px auto"><%= t('Founded in {year} by 35 Gujarati families, GSA now represents more than 300 families across Arkansas — preserving and celebrating Gujarati culture, language and the Gujarati Hindu religious tradition for present and future generations.', { year: org.founded }) %></p>
  <div class="actions" style="justify-content:center">
    <a class="btn big-touch" href="/register"><%= t('Become a member') %></a>
    <a class="btn secondary big-touch" href="/login"><%= t('Member sign in') %></a>
  </div>
  <% if (demoMode) { %><p class="small muted" style="max-width:640px;margin:12px auto 0"><%= t('This is a demo site with sample data. Tap "Member sign in" to try it as a member, or "Committee & volunteer sign-in" at the bottom of the page to try the admin or door check-in.') %></p><% } %>
</section>
<%# Plain information, not boxes: boxes looked like tabs people tried to tap. %>
<section class="perks">
  <h2><%= t('What members get') %></h2>
  <ul>
    <li><span class="perk-icon" aria-hidden="true">📇</span><span><strong><%= t('Your family profile') %></strong><br><span class="muted"><%= t('Contact details, address, native place and family members in one place.') %></span></span></li>
    <li><span class="perk-icon" aria-hidden="true">🪔</span><span><strong><%= t('Events & RSVPs') %></strong><br><span class="muted"><%= t('Garba, Diwali, bhajans, picnics and more — RSVP for your family in seconds.') %></span></span></li>
    <li><span class="perk-icon" aria-hidden="true">🎟️</span><span><strong><%= t('QR check-in') %></strong><br><span class="muted"><%= t('Show your QR code at the door — no paper lists, no waiting.') %></span></span></li>
    <li><span class="perk-icon" aria-hidden="true">💳</span><span><strong><%= t('Membership dues') %></strong><br><span class="muted"><%= t('Pay or renew your membership securely online.') %></span></span></li>
  </ul>
</section>
<div class="actions" style="justify-content:center;margin-top:8px">
  <a class="btn secondary small" href="/about"><%= t('About us') %></a>
  <a class="btn secondary small" href="/committee"><%= t('Committee members') %></a>
  <a class="btn secondary small" href="/sponsors"><%= t('Sponsors') %></a>
  <a class="btn secondary small" href="/contact"><%= t('Contact') %></a>
</div>
<%- include('partials/foot') %>
