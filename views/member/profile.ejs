<%- include('../partials/head') %>
<div class="page-head"><h1>My profile</h1>
  <form method="post" action="/logout"><%- include('../partials/csrf') %><button class="btn secondary small"><%- include('../partials/icon', { name: 'logout' }) %> Sign out</button></form>
</div>
<div class="card">
  <h2>Personal &amp; contact details</h2>
  <form method="post" action="/profile" class="stack">
    <%- include('../partials/csrf') %>
    <%- include('../partials/profile-fields', { p: profile }) %>
    <p class="muted small">Email: <strong><%= user.email %></strong> (contact an admin to change your email)</p>
    <div><button class="btn">Save profile</button></div>
  </form>
</div>

<div class="card" id="family">
  <h2>Family members</h2>
  <% if (coverage) { %>
    <p>Your <strong><%= membership.plan.name %></strong> membership covers <strong><%= coverage %></strong>. Family listed here can come with you to events. <a href="/membership">Change level</a></p>
  <% } else { %>
    <p class="muted">List the family members your membership will cover (spouse, unmarried children, parents), then <a href="/membership">choose your membership level</a>.</p>
  <% } %>
  <% if (household.length) { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Name</th><th>Relationship</th><th>Birth year</th><th></th></tr></thead>
    <tbody>
    <% for (const h of household) { %>
      <tr><td><%= h.name %></td><td><%= h.relationship || '' %></td><td><%= h.birth_year || '' %></td>
        <td class="num"><form method="post" action="/profile/household/<%= h.id %>/delete" class="inline"><%- include('../partials/csrf') %><button class="btn secondary small">Remove</button></form></td></tr>
    <% } %>
    </tbody>
  </table></div>
  <% } %>
  <form method="post" action="/profile/household" class="stack" style="margin-top:12px">
    <%- include('../partials/csrf') %>
    <div class="fields">
      <label>Name <input name="name" required></label>
      <label>Relationship
        <select name="relationship">
          <% for (const r of relationships) { %><option><%= r %></option><% } %>
        </select>
      </label>
      <label>Birth year (optional) <input name="birth_year" inputmode="numeric" pattern="\d{4}"></label>
    </div>
    <div><button class="btn secondary">Add family member</button></div>
  </form>
</div>

<div class="card">
  <h2>Change password</h2>
  <form method="post" action="/profile/password" class="stack">
    <%- include('../partials/csrf') %>
    <div class="fields">
      <label>Current password <input type="password" name="current_password" required autocomplete="current-password"></label>
      <label>New password <input type="password" name="new_password" minlength="8" required autocomplete="new-password"></label>
      <label>Confirm new password <input type="password" name="new_password_confirm" minlength="8" required autocomplete="new-password"></label>
    </div>
    <div><button class="btn secondary">Change password</button></div>
  </form>
</div>
<%- include('../partials/foot') %>
