<%- include('../partials/head') %>
<%# Sign out is in the header on every page, so it isn't repeated here. %>
<div class="page-head"><h1><%= t('My profile') %></h1></div>
<div class="card">
  <h2><%= t('Personal & contact details') %></h2>
  <form method="post" action="/profile" class="stack">
    <%- include('../partials/csrf') %>
    <%- include('../partials/profile-fields', { p: profile, required: true }) %>
    <p class="muted small"><%= t('Email') %>: <strong><%= user.email %></strong> (<%= t('contact an admin to change your email') %>)</p>
    <div><button class="btn"><%= t('Save profile') %></button></div>
  </form>
</div>

<div class="card" id="family">
  <h2><%= t('Family members') %></h2>
  <% if (owner) { %>
    <p><%= t("You're part of {owner}'s family membership. {first} manages this list.", { owner: `${owner.first_name} ${owner.last_name}`, first: owner.first_name }) %></p>
    <ul class="family-list">
      <li><strong><%= owner.first_name %> <%= owner.last_name %></strong> <span class="muted">· <%= t('Member') %></span></li>
      <% for (const h of household) { %><li><strong><%= h.name %></strong> <span class="muted">· <%= t.data(h.relationship) || '' %></span><%= h.login_user_id === profile.id ? ` (${t('you')})` : '' %></li><% } %>
    </ul>
  <% } else { %>
  <% if (coverageParts) { %>
    <p><%= t('Your {plan} membership covers {coverage}.', { plan: loc(membership.plan, 'name').replace(/\s+(membership|સભ્યપદ)$/i, ''), coverage: { list: coverageParts } }) %>
      <%= t('Family listed here can come with you to events.') %> <a href="/membership"><%= t('Change level') %></a></p>
  <% } else { %>
    <p class="muted"><%= t('List the family members your membership will cover (spouse, unmarried children, parents), then choose your membership level.') %> <a href="/membership"><%= t('Membership levels') %></a></p>
  <% } %>
  <% if (household.length) { %>
  <div class="family-rows">
    <% for (const h of household) { %>
      <% const inviteOpen = !h.login_user_id && h.invite_token && h.invite_expires > now; %>
      <div class="family-row">
        <div class="family-head">
          <% const locked = h.birth_year && h.birth_month; const child = ['Son', 'Daughter'].includes(h.relationship); %>
          <div><strong><%= h.name %></strong>
            <div class="muted small"><%= t.data(h.relationship) || '' %><% if (locked) { %> · <%= t('Born {date}', { date: new Date(Date.UTC(h.birth_year, h.birth_month - 1, 1)).toLocaleString(lang === 'gu' ? 'gu-IN' : 'en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }) }) %> 🔒<% } else if (h.birth_year) { %> · <%= t('Birth year') %> <%= h.birth_year %><% } %></div>
            <% if (child && locked) { %><div class="muted small"><%= t('To change or remove, ask a committee member') %></div><% } %></div>
          <% if (!(child && locked)) { %>
          <form method="post" action="/profile/household/<%= h.id %>/delete" class="inline" onsubmit="return confirm(<%= JSON.stringify(t('Remove {name} from your family list?', { name: h.name })) %>)"><%- include('../partials/csrf') %><button class="btn secondary small"><%= t('Remove') %></button></form>
          <% } %>
        </div>
        <% if (!locked) { %>
          <%# Family added before birth dates were required: fill them in once (then locked). %>
          <form method="post" action="/profile/household/<%= h.id %>/birth" class="birth-once needed">
            <%- include('../partials/csrf') %>
            <p class="small" style="margin:6px 0 4px"><%= child ? t('Add {name}\'s birth month and year — needed for event prices (e.g. children free up to a certain age).', { name: h.name }) : t("Add {name}'s birth month and year (required for everyone on the family list).", { name: h.name }) %></p>
            <div class="fields"><%- include('../partials/birth-fields', { required: true, h, yearPlaceholder: child ? '2016' : '1960' }) %></div>
            <div><button class="btn secondary small"><%= t('Save — can\'t be changed later') %></button></div>
          </form>
        <% } %>
        <div class="small" style="margin-top:6px">
          <% if (h.login_user_id) { %><span class="badge ok"><%= t('Has own login') %></span>
          <% } else if (!inviteOpen) { %>
            <form method="post" action="/profile/household/<%= h.id %>/invite" class="inline"><%- include('../partials/csrf') %>
              <button class="btn secondary small"><%= t('Create invite link') %></button></form>
            <span class="muted"><%= t('Give them their own login') %></span>
          <% } %>
        </div>
        <% if (inviteOpen) { %>
          <% const link = `${baseUrl}/join/family/${h.invite_token}`; const msg = t('Join our family on the GSA app: {url}', { url: link }); %>
          <div class="invite-panel" id="invite-<%= h.id %>">
            <strong><%= t('Invite link for {name}', { name: h.name }) %></strong>
            <p class="small muted" style="margin:2px 0 8px"><%= t('Send this private link only to {name}. It works once and expires on {date}.', { name: h.name, date: fmtDay(h.invite_expires) }) %></p>
            <input class="invite-link" value="<%= link %>" readonly aria-label="<%= t('Invite link for {name}', { name: h.name }) %>" onclick="this.select()">
            <div class="actions" style="margin-top:8px">
              <a class="btn small" href="https://wa.me/?text=<%= encodeURIComponent(msg) %>" target="_blank" rel="noopener"><%= t('Send by WhatsApp') %></a>
              <a class="btn secondary small" href="sms:?&body=<%= encodeURIComponent(msg) %>"><%= t('Send by text message') %></a>
              <button type="button" class="btn secondary small" data-copy="<%= link %>" data-copied="<%= t('Copied!') %>"><%= t('Copy link') %></button>
              <form method="post" action="/profile/household/<%= h.id %>/invite/cancel" class="inline"><%- include('../partials/csrf') %><button class="btn secondary small"><%= t('Cancel invite') %></button></form>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
  <% } %>
  <form method="post" action="/profile/household" class="stack" style="margin-top:12px">
    <%- include('../partials/csrf') %>
    <div class="fields">
      <label><%= t('Name') %> <input name="name" required maxlength="80" pattern="[\p{L}\p{M}][\p{L}\p{M}' .\-]*" title="<%= t("A family member's name can only contain letters (and spaces, hyphens or apostrophes).") %>"></label>
      <label><%= t('Relationship') %>
        <select name="relationship">
          <% for (const r of relationships) { %><option value="<%= r %>"><%= t.data(r) %></option><% } %>
        </select>
      </label>
      <%- include('../partials/birth-fields', { required: true, star: '<span class="req" aria-hidden="true">*</span>' }) %>
    </div>
    <p class="small muted" style="margin:0"><%= t("Everyone's birth month and year are required (children's event prices depend on age). Once saved, a child's can only be changed by a committee member.") %></p>
    <div><button class="btn secondary"><%= t('Add family member') %></button></div>
  </form>
  <% } %>
</div>

<div class="card" id="celebrations">
  <h2>🎉 <%= t('Celebrations') %></h2>
  <p class="muted"><%= t('Share birthdays and your wedding anniversary so other GSA members can send good wishes. Members see them on the Home and News pages in the week of the day. Only the month and day are shown, never the year or age. Nothing is shared unless you tick the box.') %></p>
  <form method="post" action="/profile/celebrations" class="stack">
    <%- include('../partials/csrf') %>
    <%# Their birth month and year come from Personal details; here they only add the day. %>
    <div class="fields">
      <div class="stack-tight">
        <span class="field-title"><%= t('Your birthday') %></span>
        <% if (profile.birth_month && profile.birth_year) { %>
          <div class="actions birthday-pick">
            <span class="locked-field" title="<%= t('Change under Personal details above') %>"><%= new Intl.DateTimeFormat(lang === 'gu' ? 'gu-IN' : 'en-US', { month: lang === 'gu' ? 'long' : 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(profile.birth_year, profile.birth_month - 1, 15))) %></span>
            <select class="day" name="birthday_day" aria-label="<%= t('Day of your birthday') %>">
              <option value=""><%= t('Day') %></option>
              <% const myDay = profile.birthday ? Number(profile.birthday.slice(3)) : 0; %>
              <% for (let d = 1; d <= new Date(Date.UTC(profile.birth_year, profile.birth_month, 0)).getUTCDate(); d++) { %><option value="<%= d %>" <%= myDay === d ? 'selected' : '' %>><%= d %></option><% } %>
            </select>
          </div>
          <label class="check"><input type="checkbox" name="share_birthday" value="1" <%= profile.share_birthday ? 'checked' : '' %>> <span><%= t('Share my birthday') %></span></label>
        <% } else { %>
          <p class="small muted" style="margin:0"><%= t('Add your birth month and year under Personal details above first.') %></p>
        <% } %>
      </div>
      <div class="stack-tight">
        <label><%= t('Wedding anniversary (optional)') %> <input type="date" name="anniversary" value="<%= profile.anniversary || '' %>"></label>
        <label class="check"><input type="checkbox" name="share_anniversary" value="1" <%= profile.share_anniversary ? 'checked' : '' %>> <span><%= t('Share our wedding anniversary') %></span></label>
      </div>
    </div>
    <% const kids = owner ? [] : household.filter((h) => !h.login_user_id); %>
    <% if (kids.length) { %>
      <h3 style="margin-bottom:0"><%= t("Family members' birthdays") %></h3>
      <p class="small muted" style="margin:0"><%= t("Optional. For children, the birth month and year are locked; just add the day to celebrate their birthday.") %></p>
      <% const months = Array.from({ length: 12 }, (_, i) => new Intl.DateTimeFormat(lang === 'gu' ? 'gu-IN' : 'en-US', { month: 'long', timeZone: 'UTC' }).format(new Date(Date.UTC(2024, i, 15)))); %>
      <% for (const h of kids) { %>
        <% const [bm, bd] = (h.birthday || '-').split('-'); %>
        <fieldset class="birthday-row">
          <legend><strong><%= h.name %></strong> <span class="muted small">· <%= t.data(h.relationship) || '' %></span></legend>
          <div class="actions">
            <% if (h.birth_month && h.birth_year) { %>
              <%# A child's birth month and year are locked (they set event prices), so only the day is theirs to add. %>
              <input type="hidden" name="birthday_month_<%= h.id %>" value="<%= h.birth_month %>">
              <span class="locked-field" title="<%= t('To change, ask a committee member') %>"><%= new Intl.DateTimeFormat(lang === 'gu' ? 'gu-IN' : 'en-US', { month: lang === 'gu' ? 'long' : 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(h.birth_year, h.birth_month - 1, 15))) %> 🔒</span>
              <select class="day" name="birthday_day_<%= h.id %>" aria-label="<%= t('Birthday day for {name}', { name: h.name }) %>">
                <option value=""><%= t('Day') %></option>
                <% for (let d = 1; d <= new Date(Date.UTC(h.birth_year, h.birth_month, 0)).getUTCDate(); d++) { %><option value="<%= d %>" <%= Number(bd) === d ? 'selected' : '' %>><%= d %></option><% } %>
              </select>
            <% } else { %>
            <select name="birthday_month_<%= h.id %>" aria-label="<%= t('Birthday month for {name}', { name: h.name }) %>">
              <option value=""><%= t('Month') %></option>
              <% months.forEach((name, i) => { %><option value="<%= i + 1 %>" <%= Number(bm) === i + 1 ? 'selected' : '' %>><%= name %></option><% }) %>
            </select>
            <select class="day" name="birthday_day_<%= h.id %>" aria-label="<%= t('Birthday day for {name}', { name: h.name }) %>">
              <option value=""><%= t('Day') %></option>
              <% for (let d = 1; d <= 31; d++) { %><option value="<%= d %>" <%= Number(bd) === d ? 'selected' : '' %>><%= d %></option><% } %>
            </select>
            <% } %>
            <label class="check"><input type="checkbox" name="share_birthday_<%= h.id %>" value="1" <%= h.share_birthday ? 'checked' : '' %>> <span><%= t('Share') %></span></label>
          </div>
        </fieldset>
      <% } %>
      <p class="small muted"><%= t('Family members with their own login share their birthday from their own profile.') %></p>
    <% } %>
    <div><button class="btn secondary"><%= t('Save celebration settings') %></button></div>
  </form>
</div>

<div class="card" id="privacy">
  <h2><%= t('Directory settings') %></h2>
  <form method="post" action="/profile/privacy" class="stack">
    <%- include('../partials/csrf') %>
    <label class="check"><input type="checkbox" name="directory_listed" value="1" <%= profile.directory_listed ? 'checked' : '' %>> <%= t('List me in the member directory (name, city and native place)') %></label>
    <label class="check"><input type="checkbox" name="directory_contact" value="1" <%= profile.directory_contact ? 'checked' : '' %>> <%= t('Also show my phone number and email to other members') %></label>
    <div><button class="btn secondary"><%= t('Save directory settings') %></button></div>
  </form>
</div>

<div class="card">
  <h2><%= t('Change password') %></h2>
  <form method="post" action="/profile/password" class="stack">
    <%- include('../partials/csrf') %>
    <div class="fields">
      <label><%= t('Current password') %> <input type="password" name="current_password" required autocomplete="current-password"></label>
      <label><%= t('New password') %> <input type="password" name="new_password" minlength="8" required autocomplete="new-password"></label>
      <label><%= t('Confirm new password') %> <input type="password" name="new_password_confirm" minlength="8" required autocomplete="new-password"></label>
    </div>
    <div><button class="btn secondary"><%= t('Change password') %></button></div>
  </form>
</div>
<%# Full display settings at the end: the header's ગુજરાતી, light/dark and A+ buttons cover everyday switching. %>
<%- include('../partials/display-settings') %>
<script>
  // Copy an invite link (older phones: the link box is selected so it can be copied by hand).
  document.querySelectorAll('[data-copy]').forEach((btn) => btn.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(btn.dataset.copy); btn.textContent = btn.dataset.copied; }
    catch { btn.closest('.invite-panel').querySelector('.invite-link').select(); }
  }));
</script>
<%- include('../partials/foot') %>
