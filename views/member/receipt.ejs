<%- include('../partials/head') %>
<div class="receipt card">
  <div class="receipt-head">
    <img src="/logo.png" alt="" width="64" height="64">
    <div>
      <strong><%= t.data(orgName) %></strong><br>
      <span class="small muted"><%= org.address.join(', ') %><br><%= org.phone %> · <%= org.email %><% if (org.ein) { %><br>EIN <%= org.ein %><% } %></span>
    </div>
    <div class="receipt-no"><span class="muted small"><%= t('Receipt') %></span><br><strong><%= number %></strong></div>
  </div>
  <h1><%= payment.kind === 'donation' ? t('Donation receipt') : t('Payment receipt') %></h1>
  <div class="fields">
    <div><span class="muted small"><%= t('Received from') %></span><br><strong><%= payment.first_name %> <%= payment.last_name %></strong>
      <% if (payment.address_line1) { %><br><span class="small"><%= payment.address_line1 %><%= payment.address_line2 ? `, ${payment.address_line2}` : '' %><br><%= [payment.city, payment.state, payment.postal_code].filter(Boolean).join(', ') %></span><% } %></div>
    <div><span class="muted small"><%= t('Date') %></span><br><strong><%= fmtDate(payment.paid_at.slice(0, 10)) %></strong></div>
    <div><span class="muted small"><%= t('Payment method') %></span><br><strong><%- include('../partials/payment-method', { method: payment.method }) %><%= payment.method === 'check' && payment.provider_ref ? ` #${payment.provider_ref}` : '' %></strong></div>
  </div>
  <table style="margin:16px 0">
    <thead><tr><th><%= t('Description') %></th><th class="num"><%= t('Amount') %></th></tr></thead>
    <tbody><tr><td><%- include('../partials/payment-desc', { p: payment }) %><% if (payment.note) { %><div class="muted small"><%= payment.note %></div><% } %></td><td class="num"><%= money(payment.amount_cents) %></td></tr></tbody>
    <tfoot><tr><th><%= t('Total') %></th><th class="num"><%= money(payment.amount_cents) %></th></tr></tfoot>
  </table>
  <% if (payment.kind === 'donation') { %>
    <p class="small"><%= org.ein ? t('{org} is a tax-exempt organization under Section 501(c)(3) of the Internal Revenue Code (EIN {ein}).', { org: t.data(orgName), ein: org.ein }) : t('{org} is a tax-exempt organization under Section 501(c)(3) of the Internal Revenue Code.', { org: t.data(orgName) }) %>
      <%= t('No goods or services were provided in exchange for this contribution. Please keep this receipt for your tax records.') %></p>
    <% if (lang === 'gu') { %><p class="small muted" lang="en">Tax statement (English): <%= orgName %> is a tax-exempt organization under Section 501(c)(3) of the Internal Revenue Code<%= org.ein ? ` (EIN ${org.ein})` : '' %>. No goods or services were provided in exchange for this contribution.</p><% } %>
  <% } %>
  <p class="small muted"><%= t('Thank you for supporting the {org} — “{motto}”.', { org: t.data(orgName), motto: loc(org, 'motto') }) %></p>
  <div class="actions no-print"><button class="btn" onclick="window.print()"><%= t('Print / Save as PDF') %></button><a class="btn secondary" href="/payments"><%= t('My payments') %></a></div>
</div>
<%- include('../partials/foot') %>
