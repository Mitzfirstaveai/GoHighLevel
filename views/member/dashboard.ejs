<%- include('../partials/head') %>
<div class="page-head"><h1>Namaste, <%= user.first_name %> 🙏</h1></div>
<div class="card install-card" id="install-card" hidden>
  <img src="/icon-192.png" alt="" width="48" height="48">
  <div style="flex:1">
    <strong>Get the GSA app</strong>
    <div class="small muted">Add it to your home screen — your QR tickets work even without signal.</div>
    <div class="small" data-ios hidden>On iPhone: tap <strong>Share</strong> <span aria-hidden="true">⎋</span> then <strong>Add to Home Screen</strong>.</div>
  </div>
  <button class="btn small" data-install hidden>Install</button>
  <button class="linkish" data-dismiss aria-label="Dismiss">✕</button>
</div>
<div class="tiles">
  <a class="tile primary" href="/tickets"><%- include('../partials/icon', { name: 'ticket' }) %>My QR tickets<small><%= myRsvps.filter((r) => r.status === 'confirmed').length %> upcoming</small></a>
  <a class="tile" href="/events"><%- include('../partials/icon', { name: 'calendar' }) %>Events &amp; RSVP<small>See what's coming up</small></a>
  <a class="tile" href="/membership"><%- include('../partials/icon', { name: 'card' }) %><%= membership.active ? 'Membership' : 'Pay dues' %><small><%= membership.active ? `Active until ${fmtDate(membership.current.end_date)}` : 'Not active' %></small></a>
  <a class="tile" href="/profile"><%- include('../partials/icon', { name: 'users' }) %>My family<small>Update your details</small></a>
</div>
<% if (latestNews) { %>
<a class="card" href="/news" style="display:block;text-decoration:none;color:inherit;border-left:4px solid var(--green)">
  <div class="small muted">📢 Latest news · <%= fmtDate(latestNews.created_at.slice(0, 10)) %></div>
  <strong><%= latestNews.title %></strong>
  <div class="muted small" style="margin-top:4px"><%= latestNews.body.length > 140 ? latestNews.body.slice(0, 140) + '…' : latestNews.body %></div>
</a>
<% } %>
<div class="grid grid-2">
  <div class="card">
    <h2>Membership</h2>
    <% if (membership.active) { %>
      <p><span class="badge ok">Active</span> <%= membership.current.plan_name || 'Member' %> — valid until <strong><%= fmtDate(membership.current.end_date) %></strong></p>
      <a class="btn secondary small" href="/membership">Renew or view history</a>
    <% } else { %>
      <p><span class="badge warn"><%= membership.current ? 'Expired' : 'Not a paid member yet' %></span></p>
      <a class="btn" href="/membership">Pay membership</a>
    <% } %>
  </div>
  <div class="card">
    <h2>My profile</h2>
    <p class="muted">Keep your contact information and family members up to date.</p>
    <a class="btn secondary small" href="/profile">Edit profile</a>
  </div>
</div>

<div class="card">
  <h2>My upcoming events</h2>
  <% if (!myRsvps.length) { %><p class="muted">You haven't RSVP'd to any upcoming events.</p><% } %>
  <div class="event-list">
  <% for (const r of myRsvps) { %>
    <div class="event-item">
      <%- include('../partials/date-chip', { when: r.starts_at }) %>
      <div style="flex:1">
        <strong><%= r.title %></strong> <%- include('../partials/rsvp-badge', { status: r.status }) %>
        <div class="muted small"><%= fmtDate(r.starts_at) %><%= r.location ? ` · ${r.location}` : '' %> · <%= r.party_size %> <%= r.party_size === 1 ? 'person' : 'people' %></div>
        <div class="actions" style="margin-top:6px">
          <% if (r.status === 'confirmed') { %><a class="btn small" href="/tickets/<%= r.id %>">Show QR ticket</a><% } %>
          <a class="btn secondary small" href="/events/<%= r.event_id %>"><%= r.status === 'pending_payment' ? 'Complete payment' : 'Details' %></a>
        </div>
      </div>
    </div>
  <% } %>
  </div>
</div>

<div class="card">
  <div class="page-head"><h2 style="margin:0">Coming up</h2><a href="/events">All events →</a></div>
  <% if (!upcoming.length) { %><p class="muted">No other events scheduled right now.</p><% } %>
  <div class="event-list">
  <% for (const e of upcoming) { %>
    <a class="event-item" href="/events/<%= e.id %>">
      <%- include('../partials/date-chip', { when: e.starts_at }) %>
      <div><strong><%= e.title %></strong><div class="muted small"><%= fmtDate(e.starts_at) %><%= e.location ? ` · ${e.location}` : '' %> · <%= e.fee_cents ? `${money(e.fee_cents)} per person` : 'Free' %></div></div>
    </a>
  <% } %>
  </div>
</div>
<div class="tiles">
  <a class="tile" href="/directory"><%- include('../partials/icon', { name: 'book' }) %>Member directory<small>Find community members</small></a>
  <a class="tile" href="/news"><%- include('../partials/icon', { name: 'news' }) %>News<small>Announcements</small></a>
  <a class="tile" href="/committee"><%- include('../partials/icon', { name: 'users' }) %>Committee<small>Trustees &amp; executive</small></a>
  <a class="tile" href="/contact"><%- include('../partials/icon', { name: 'phone' }) %>Contact GSA<small><%= org.phone %></small></a>
</div>
<%- include('../partials/foot') %>
