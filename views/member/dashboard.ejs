<%- include('../partials/head') %>
<%# Home, in order of what members need most: today's ticket, status tiles, their events, GSA announcement, celebrations,
    what's on, then Gujarat & India headlines to read. %>
<div class="page-head"><h1><%= t('Namaste, {name}', { name: user.first_name }) %> 🙏</h1></div>
<% for (const r of todayTickets) { %>
  <section class="today-banner" aria-label="<%= t('Today') %>">
    <div>
      <div class="today-label"><%= t('Today') %> · <%= fmtTime(r.starts_at) %></div>
      <strong><%= loc(r, 'title') %></strong>
      <div class="small"><%= String(r.location || '').split(/[|,]/)[0].trim() %></div>
    </div>
    <a class="btn big-touch" href="/tickets/<%= r.id %>"><%- include('../partials/icon', { name: 'ticket' }) %> <%= t('Show QR ticket') %></a>
  </section>
<% } %>
<div class="card install-card" id="install-card" hidden>
  <img src="/icon-192.png" alt="" width="48" height="48">
  <div style="flex:1">
    <strong><%= t('Get the GSA app') %></strong>
    <div class="small muted"><%= t('Add it to your home screen — your QR tickets work even without signal.') %></div>
    <div class="small" data-ios hidden><%= t('On iPhone: tap the Share button, then "Add to Home Screen".') %></div>
  </div>
  <button class="btn small" data-install hidden><%= t('Install') %></button>
  <button class="linkish" data-dismiss aria-label="<%= t('Dismiss') %>">✕</button>
</div>
<div class="tiles">
  <a class="tile primary" href="/tickets"><%- include('../partials/icon', { name: 'ticket' }) %><%= t('My QR tickets') %><small><%= t('{n} upcoming', { n: myRsvps.filter((r) => r.status === 'confirmed').length }) %></small></a>
  <%# Membership: status badge, level, dates and what to do next. Turns yellow when dues are owed. %>
  <% if (membership.active) { %>
    <a class="tile" href="/membership"><%- include('../partials/icon', { name: 'card' }) %>
      <span class="tile-title"><%= t('Membership') %> <span class="badge ok"><%= t('Active') %></span></span>
      <small><% if (membership.plan) { %><strong><%= loc(membership.plan, 'name') %></strong><br><% } %><%= t('Active until {date}', { date: fmtDate(membership.current.end_date) }) %></small>
      <% if (holder) { %><small><%= t('Held by {name}', { name: `${holder.first_name} ${holder.last_name}` }) %></small>
      <% } else if (canRenew) { %><small class="tile-action">▸ <%= renewYear ? t('Renew for {year}', { year: renewYear }) : t('Renew now') %></small><% } %>
    </a>
  <% } else { %>
    <a class="tile warn" href="/membership"><%- include('../partials/icon', { name: 'card' }) %>
      <span class="tile-title"><%= holder ? t('Membership') : t('Pay dues') %> <span class="badge warn"><%= membership.current ? t('Expired') : t('Not active') %></span></span>
      <small><%= membership.current ? t('Expired {date}', { date: fmtDate(membership.current.end_date) }) : t('Not a paid member yet') %></small>
      <% if (holder) { %><small><%= t('{name} renews the family membership.', { name: holder.first_name }) %></small><% } %>
    </a>
  <% } %>
  <a class="tile" href="/profile"><%- include('../partials/icon', { name: 'users' }) %><%= t('My profile & family') %><small><%= t('Contact details, family members') %></small></a>
  <a class="tile" href="/donate"><%- include('../partials/icon', { name: 'heart' }) %><%= t('Donate') %><small><%= t('Support GSA') %></small></a>
</div>

<div class="card">
  <div class="page-head" style="margin-bottom:4px"><h2 style="margin:0"><%= t('My upcoming events') %></h2><a href="/tickets"><%= t('My tickets') %> →</a></div>
  <% if (!myRsvps.length) { %><p class="muted" style="margin-bottom:0"><%= t("You haven't RSVP'd to any upcoming events.") %></p><% } %>
  <div class="event-list">
  <% for (const r of myRsvps) { %>
    <div class="event-item">
      <%- include('../partials/date-chip', { when: r.starts_at }) %>
      <div style="flex:1">
        <strong><%= loc(r, 'title') %></strong> <%- include('../partials/rsvp-badge', { status: r.status }) %>
        <div class="muted small"><%- include('../partials/event-line', { event: r, showPrice: false }) %></div>
        <%- include('../partials/ticket-names', { tk: r }) %>
        <% if (!r.mine) { %><div class="small muted"><%= t("{name}'s ticket", { name: `${r.holder_first} ${r.holder_last}` }) %></div><% } %>
        <div class="actions" style="margin-top:6px">
          <% if (r.status === 'confirmed') { %><a class="btn small" href="/tickets/<%= r.id %>"><%= t('Show QR ticket') %></a><% } %>
          <a class="btn secondary small" href="/events/<%= r.event_id %>"><%= r.status === 'pending_payment' ? t('Complete payment') : t('Details') %></a>
        </div>
      </div>
    </div>
  <% } %>
  </div>
</div>

<%# The latest GSA announcement stays near the top: it's from GSA and often time-sensitive. %>
<% if (latestNews) { %>
<section class="card home-news">
  <div class="page-head" style="margin-bottom:8px"><h2 style="margin:0">📢 <%= t('GSA announcements') %></h2><a href="/news"><%= t('All announcements') %> →</a></div>
  <a class="home-announcement" href="/news">
    <div class="small muted"><%= fmtDay(latestNews.created_at) %></div>
    <strong><%= loc(latestNews, 'title') %></strong>
    <% const newsBody = loc(latestNews, 'body'); %>
    <div class="muted small"><%= newsBody.length > 140 ? newsBody.slice(0, 140) + '…' : newsBody %></div>
  </a>
</section>
<% } %>

<% if (celebrations.length) { %><%- include('../partials/celebrations') %><% } %>

<div class="card">
  <div class="page-head" style="margin-bottom:4px"><h2 style="margin:0"><%= t('Coming up') %></h2><a href="/events"><%= t('All events') %> →</a></div>
  <% if (!upcoming.length) { %><p class="muted" style="margin-bottom:0"><%= t('No other events scheduled right now.') %></p><% } %>
  <div class="event-list">
  <% for (const e of upcoming) { %>
    <a class="event-item" href="/events/<%= e.id %>">
      <%- include('../partials/date-chip', { when: e.starts_at }) %>
      <div><strong><%= loc(e, 'title') %></strong><div class="muted small"><%- include('../partials/event-line', { event: e, showPrice: true }) %></div></div>
    </a>
  <% } %>
  </div>
</div>
<%# Gujarat & India headlines: reading for the end of the page. %>
<% if (headlines.length) { %>
<section class="card home-headlines">
  <div class="page-head" style="margin-bottom:4px"><h2 style="margin:0">📰 <%= t('Gujarat & India news') %></h2><a href="/news/india"><%= t('More news') %> →</a></div>
  <ul>
    <% for (const h of headlines) { %>
      <li><a href="/news/india#n<%= h.id %>" lang="<%= h.lang %>"><%= h.title %></a> <span class="muted small">· <%= h.source_name %></span></li>
    <% } %>
  </ul>
</section>
<% } %>
<%- include('../partials/foot') %>
