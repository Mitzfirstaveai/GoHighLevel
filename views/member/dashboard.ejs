<%- include('../partials/head') %>
<div class="page-head"><h1><%= t('Namaste, {name}', { name: user.first_name }) %> 🙏</h1></div>
<div class="card install-card" id="install-card" hidden>
  <img src="/icon-192.png" alt="" width="48" height="48">
  <div style="flex:1">
    <strong><%= t('Get the GSA app') %></strong>
    <div class="small muted"><%= t('Add it to your home screen — your QR tickets work even without signal.') %></div>
    <div class="small" data-ios hidden><%= t('On iPhone: tap the Share button, then "Add to Home Screen".') %></div>
  </div>
  <button class="btn small" data-install hidden><%= t('Install') %></button>
  <button class="linkish" data-dismiss aria-label="<%= t('Dismiss') %>">✕</button>
</div>
<div class="tiles">
  <a class="tile primary" href="/tickets"><%- include('../partials/icon', { name: 'ticket' }) %><%= t('My QR tickets') %><small><%= t('{n} upcoming', { n: myRsvps.filter((r) => r.status === 'confirmed').length }) %></small></a>
  <a class="tile" href="/events"><%- include('../partials/icon', { name: 'calendar' }) %><%= t('Events & RSVP') %><small><%= t("See what's coming up") %></small></a>
  <a class="tile" href="/membership"><%- include('../partials/icon', { name: 'card' }) %><%= membership.active ? t('Membership') : t('Pay dues') %><small><%= membership.active ? t('Active until {date}', { date: fmtDate(membership.current.end_date) }) : t('Not active') %></small></a>
  <a class="tile" href="/profile"><%- include('../partials/icon', { name: 'users' }) %><%= t('My family') %><small><%= t('Update your details') %></small></a>
</div>
<% if (latestNews) { %>
<a class="card" href="/news" style="display:block;text-decoration:none;color:inherit;border-left:4px solid var(--green)">
  <div class="small muted">📢 <%= t('Latest news') %> · <%= fmtDate(latestNews.created_at.slice(0, 10)) %></div>
  <strong><%= loc(latestNews, 'title') %></strong>
  <% const newsBody = loc(latestNews, 'body'); %>
  <div class="muted small" style="margin-top:4px"><%= newsBody.length > 140 ? newsBody.slice(0, 140) + '…' : newsBody %></div>
</a>
<% } %>
<div class="grid grid-2">
  <div class="card">
    <h2><%= t('Membership') %></h2>
    <% if (membership.active) { %>
      <p><span class="badge ok"><%= t('Active') %></span> <%= membership.plan ? loc(membership.plan, 'name') : t('Member') %> — <%= t('valid until') %> <strong><%= fmtDate(membership.current.end_date) %></strong></p>
      <a class="btn secondary small" href="/membership"><%= t('Renew or view history') %></a>
    <% } else { %>
      <p><span class="badge warn"><%= membership.current ? t('Expired') : t('Not a paid member yet') %></span></p>
      <a class="btn" href="/membership"><%= t('Pay membership') %></a>
    <% } %>
  </div>
  <div class="card">
    <h2><%= t('My profile') %></h2>
    <p class="muted"><%= t('Keep your contact information and family members up to date.') %></p>
    <a class="btn secondary small" href="/profile"><%= t('Edit profile') %></a>
  </div>
</div>

<div class="card">
  <h2><%= t('My upcoming events') %></h2>
  <% if (!myRsvps.length) { %><p class="muted"><%= t("You haven't RSVP'd to any upcoming events.") %></p><% } %>
  <div class="event-list">
  <% for (const r of myRsvps) { %>
    <div class="event-item">
      <%- include('../partials/date-chip', { when: r.starts_at }) %>
      <div style="flex:1">
        <strong><%= loc(r, 'title') %></strong> <%- include('../partials/rsvp-badge', { status: r.status }) %>
        <div class="muted small"><%= fmtDate(r.starts_at) %><%= r.location ? ` · ${r.location}` : '' %> · <%= plural(r.party_size, '1 person', '{n} people') %></div>
        <div class="actions" style="margin-top:6px">
          <% if (r.status === 'confirmed') { %><a class="btn small" href="/tickets/<%= r.id %>"><%= t('Show QR ticket') %></a><% } %>
          <a class="btn secondary small" href="/events/<%= r.event_id %>"><%= r.status === 'pending_payment' ? t('Complete payment') : t('Details') %></a>
        </div>
      </div>
    </div>
  <% } %>
  </div>
</div>

<div class="card">
  <div class="page-head"><h2 style="margin:0"><%= t('Coming up') %></h2><a href="/events"><%= t('All events') %> →</a></div>
  <% if (!upcoming.length) { %><p class="muted"><%= t('No other events scheduled right now.') %></p><% } %>
  <div class="event-list">
  <% for (const e of upcoming) { %>
    <a class="event-item" href="/events/<%= e.id %>">
      <%- include('../partials/date-chip', { when: e.starts_at }) %>
      <div><strong><%= loc(e, 'title') %></strong><div class="muted small"><%= fmtDate(e.starts_at) %><%= e.location ? ` · ${e.location}` : '' %> · <%- include('../partials/event-prices', { event: e }) %></div></div>
    </a>
  <% } %>
  </div>
</div>
<div class="tiles">
  <a class="tile" href="/directory"><%- include('../partials/icon', { name: 'book' }) %><%= t('Member directory') %><small><%= t('Find community members') %></small></a>
  <a class="tile" href="/news"><%- include('../partials/icon', { name: 'news' }) %><%= t('News') %><small><%= t('Announcements') %></small></a>
  <a class="tile" href="/donate"><%- include('../partials/icon', { name: 'heart' }) %><%= t('Donate') %><small><%= t('Support GSA') %></small></a>
  <a class="tile" href="/contact"><%- include('../partials/icon', { name: 'phone' }) %><%= t('Contact GSA') %><small><%= org.phone %></small></a>
</div>
<%- include('../partials/foot') %>
