<%- include('../partials/head') %>
<%# Home, in order of what members need most: their next event (green on the day), status tiles, GSA announcement,
    celebrations, what's on, then Gujarat & India headlines to read. %>
<div class="page-head"><h1><%= t('Namaste, {name}', { name: user.first_name }) %> 🙏</h1></div>
<div class="card install-card" id="install-card" hidden>
  <img src="/icon-192.png" alt="" width="48" height="48">
  <div style="flex:1">
    <strong><%= t('Get the GSA app') %></strong>
    <div class="small muted"><%= t('Add it to your home screen — your QR tickets work even without signal.') %></div>
    <%# app.js shows the steps for this device when "Install" can't open the browser's own install prompt. %>
    <div class="small install-steps" data-steps="ios" hidden><%= t('On iPhone or iPad: tap the Share button (square with an arrow), then "Add to Home Screen".') %></div>
    <div class="small install-steps" data-steps="mac" hidden><%= t('In Safari on a Mac: choose File, then "Add to Dock".') %></div>
    <div class="small install-steps" data-steps="other" hidden><%= t('Open your browser menu (⋮ or ⋯) and choose "Install app" or "Add to Home screen".') %> <%= t('This does not work in a private or incognito window.') %></div>
  </div>
  <button class="btn small" data-install><%= t('Install') %></button>
  <button class="linkish" data-dismiss aria-label="<%= t('Dismiss') %>">✕</button>
</div>
<div class="home-top">
  <%# Your next event: replaces a separate ticket tile, event list and event-day banner. Turns green on the day. %>
  <section class="card next-event<%= nextIsToday ? ' today' : '' %>" aria-label="<%= t('Your next event') %>">
    <% if (!nextTicket) { %>
      <div class="next-label"><%- include('../partials/icon', { name: 'ticket' }) %> <%= t('Your next event') %></div>
      <p class="muted"><%= t("You haven't RSVP'd to any upcoming events.") %></p>
      <div><a class="btn" href="/events"><%= t('See events') %></a></div>
    <% } else { const r = nextTicket; %>
      <div class="next-label"><%- include('../partials/icon', { name: 'ticket' }) %> <%= nextIsToday ? `${t('Today')} · ${fmtTime(r.starts_at)}` : t('Your next event') %></div>
      <div class="next-main">
        <%- include('../partials/date-chip', { when: r.starts_at }) %>
        <div>
          <a class="next-title" href="/events/<%= r.event_id %>"><%= loc(r, 'title') %></a> <%- include('../partials/rsvp-badge', { status: r.status }) %>
          <%# On the day, the label already says "Today · 7:30 PM", so just the venue. %>
          <div class="muted"><% if (nextIsToday) { %><%= String(r.location || '').split(/[|,]/)[0].trim() %><% } else { %><%- include('../partials/event-line', { event: r, showPrice: false }) %><% } %></div>
          <% if (r.due && r.status === 'confirmed') { %><div class="small pay-door-note">💵 <%= t('Pay {amount} at the door', { amount: money(r.due) }) %></div><% } %>
          <div class="small">👥 <%= r.names.length ? r.names.map((n) => n.split(' ')[0]).join(', ') : plural(r.party_size, '1 person', '{n} people') %><%= r.names.length && r.guest_count ? ` + ${plural(r.guest_count, '1 guest', '{n} guests')}` : '' %><% if (!r.mine) { %> · <%= t("{name}'s ticket", { name: `${r.holder_first} ${r.holder_last}` }) %><% } %></div>
        </div>
      </div>
      <div class="actions">
        <% if (r.status === 'confirmed') { %><a class="btn<%= nextIsToday ? ' big-touch' : '' %>" href="/tickets/<%= r.id %>"><%- include('../partials/icon', { name: 'ticket' }) %> <%= t('Show QR ticket') %></a>
        <% } else if (r.status === 'pending_payment') { %><a class="btn" href="/events/<%= r.event_id %>"><%= t('Complete payment') %></a><% } %>
        <a class="btn secondary" href="/events/<%= r.event_id %>"><%= t('Details') %></a>
      </div>
      <% if (moreEvents) { %><a class="next-more" href="/tickets"><%= plural(moreEvents, '+ 1 more event', '+ {n} more events') %> → <%= t('My tickets') %></a><% } %>
    <% } %>
  </section>
  <div class="tiles home-tiles">
  <%# Membership: status badge, level, dates and what to do next. Turns yellow when dues are owed. %>
  <% if (membership.active) { %>
    <a class="tile" href="/membership"><%- include('../partials/icon', { name: 'card' }) %><span class="tile-body">
      <span class="tile-title"><%= t('Membership') %> <span class="badge ok"><%= t('Active') %></span></span>
      <small><% if (membership.plan) { %><strong><%= loc(membership.plan, 'name') %></strong><br><% } %><%= t('Active until {date}', { date: fmtDate(membership.current.end_date) }) %></small>
      <% if (holder) { %><small><%= t('Held by {name}', { name: `${holder.first_name} ${holder.last_name}` }) %></small>
      <% } else if (canRenew) { %><small class="tile-action">▸ <%= renewYear ? t('Renew for {year}', { year: renewYear }) : t('Renew now') %></small><% } %>
    </span></a>
  <% } else { %>
    <a class="tile warn" href="/membership"><%- include('../partials/icon', { name: 'card' }) %><span class="tile-body">
      <span class="tile-title"><%= holder ? t('Membership') : t('Pay dues') %> <span class="badge warn"><%= membership.current ? t('Expired') : t('Not active') %></span></span>
      <small><%= membership.current ? t('Expired {date}', { date: fmtDate(membership.current.end_date) }) : t('Not a paid member yet') %></small>
      <% if (holder) { %><small><%= t('{name} renews the family membership.', { name: holder.first_name }) %></small><% } %>
    </span></a>
  <% } %>
  <a class="tile" href="/profile"><%- include('../partials/icon', { name: 'users' }) %><span class="tile-body"><span class="tile-title"><%= t('My profile & family') %></span><small><%= t('Contact details, family members') %></small></span></a>
  <a class="tile" href="/donate"><%- include('../partials/icon', { name: 'heart' }) %><span class="tile-body"><span class="tile-title"><%= t('Donate') %></span><small><%= t('Support GSA') %></small></span></a>
  </div>
</div>


<%# The latest GSA announcement stays near the top: it's from GSA and often time-sensitive. %>
<% if (latestNews) { %>
<section class="card home-news">
  <div class="page-head" style="margin-bottom:8px"><h2 style="margin:0">📢 <%= t('GSA announcements') %></h2><a href="/news"><%= t('All announcements') %> →</a></div>
  <a class="home-announcement" href="/news">
    <div class="small muted"><%= fmtDay(latestNews.created_at) %></div>
    <strong><%= loc(latestNews, 'title') %></strong>
    <% const newsBody = loc(latestNews, 'body'); %>
    <div class="muted small"><%= newsBody.length > 140 ? newsBody.slice(0, 140) + '…' : newsBody %></div>
  </a>
</section>
<% } %>

<% if (celebrations.length) { %><%- include('../partials/celebrations') %><% } %>

<div class="card">
  <div class="page-head" style="margin-bottom:4px"><h2 style="margin:0"><%= t('Coming up') %></h2><a href="/events"><%= t('All events') %> →</a></div>
  <% if (!upcoming.length) { %><p class="muted" style="margin-bottom:0"><%= t('No other events scheduled right now.') %></p><% } %>
  <div class="event-list">
  <% for (const e of upcoming) { %>
    <a class="event-item" href="/events/<%= e.id %>">
      <%- include('../partials/date-chip', { when: e.starts_at }) %>
      <div><strong><%= loc(e, 'title') %></strong><div class="muted small"><%- include('../partials/event-line', { event: e, showPrice: true }) %></div></div>
    </a>
  <% } %>
  </div>
</div>
<%# Gujarat & India headlines: reading for the end of the page. %>
<% if (headlines.length) { %>
<section class="card home-headlines">
  <div class="page-head" style="margin-bottom:4px"><h2 style="margin:0">📰 <%= t('Gujarat & India news') %></h2><a href="/news/india"><%= t('More news') %> →</a></div>
  <ul>
    <% for (const h of headlines) { %>
      <li><a href="/news/india#n<%= h.id %>" lang="<%= h.lang %>"><%= h.title %></a> <span class="muted small">· <%= h.source_name %></span></li>
    <% } %>
  </ul>
</section>
<% } %>
<%- include('../partials/foot') %>
