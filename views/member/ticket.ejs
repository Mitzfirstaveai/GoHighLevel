<%- include('../partials/head') %>
<a class="back no-print" href="/tickets">← <%= t('My tickets') %></a>
<div class="card ticket">
  <h1><%= loc(rsvp, 'title') %></h1>
  <p class="muted"><%= fmtDate(rsvp.starts_at) %><%= rsvp.location ? ` · ${rsvp.location}` : '' %></p>
  <% if (qrDataUrl) { %>
    <% if (rsvp.checked_in_at) { %>
      <div class="big-status ok" style="padding:10px;border-radius:10px"><%= t('Already checked in ({n})', { n: rsvp.checked_in_count }) %></div>
    <% } %>
    <img src="<%= qrDataUrl %>" alt="<%= t('QR code ticket') %>">
    <%# If the QR code won't scan, the volunteer types this instead. %>
    <% if (ticketCode) { %><p class="ticket-code"><%= t('Ticket code') %> <strong><%= ticketCode %></strong></p><% } %>
    <% if (due) { %><p class="pay-door-note">💵 <%= t('Please pay {amount} at the door (cash or check).', { amount: money(due) }) %></p><% } %>
    <p class="party-count" style="margin:8px 0 0"><%= rsvp.party_size %></p>
    <p class="muted" style="margin-top:0"><%= rsvp.party_size === 1 ? t('person registered') : t('people registered') %><%= rsvp.guest_count ? ` (${plural(rsvp.guest_count, 'incl. 1 guest', 'incl. {n} guests')})` : '' %></p>
  <% } else { %>
    <p><%- include('../partials/rsvp-badge', { status: rsvp.status }) %></p>
    <% if (rsvp.status === 'pending_payment' && mine && due) { %>
      <p><%= t('Amount due:') %> <strong><%= money(due) %></strong>. <%= t('Your QR ticket will be ready once paid.') %></p>
      <div class="actions no-print" style="justify-content:center">
        <% if (paymentMode !== 'disabled') { %><form method="post" action="/events/<%= rsvp.event_id %>/pay"><%- include('../partials/csrf') %><button class="btn"><%= t('Pay {amount}', { amount: money(due) }) %></button></form><% } %>
        <form method="post" action="/events/<%= rsvp.event_id %>/pay-at-door"><%- include('../partials/csrf') %><button class="btn secondary"><%= t('Pay at the door instead (cash or check)') %></button></form>
      </div>
    <% } %>
  <% } %>
  <% if (names.length) { %>
    <div class="ticket-for">
      <h2><%= t('This ticket is for') %></h2>
      <ul>
        <% for (const name of names) { %><li><%= name %></li><% } %>
        <% if (rsvp.guest_count) { %><li class="muted"><%= plural(rsvp.guest_count, '1 guest', '{n} guests') %></li><% } %>
      </ul>
    </div>
  <% } %>
  <% if (!mine) { %><p class="small muted"><%= t("{name}'s ticket", { name: `${rsvp.holder_first} ${rsvp.holder_last}` }) %></p><% } %>
  <% if (qrDataUrl) { %>
    <p class="small"><%= t('Show this code at the entrance. It can only be scanned once.') %></p>
    <p class="small muted"><%= t('Tip: turn your screen brightness up so the code scans quickly.') %></p>
    <div class="actions no-print" style="justify-content:center">
      <a class="btn secondary small" href="/tickets/<%= rsvp.id %>/qr.png" download><%= t('Download QR') %></a>
      <button class="btn secondary small" onclick="window.print()"><%= t('Print') %></button>
    </div>
    <% if (due && mine && paymentMode !== 'disabled') { %>
      <form method="post" action="/events/<%= rsvp.event_id %>/pay" class="no-print" style="margin-top:10px"><%- include('../partials/csrf') %>
        <button class="btn secondary small"><%= t('Pay {amount} online now instead', { amount: money(due) }) %></button></form>
    <% } %>
  <% } else { %>
    <p><%= t('Your QR ticket will appear here once your RSVP is confirmed.') %></p>
    <a class="btn" href="/events/<%= rsvp.event_id %>"><%= t('Go to event') %></a>
  <% } %>
</div>

<% if (canChange) { %>
<div class="card no-print" id="change" style="max-width:520px;margin:16px auto">
  <h2><%= t("Change who's coming") %></h2>
  <form method="post" action="/events/<%= rsvp.event_id %>/rsvp" class="stack"
        data-price="<%= JSON.stringify(prices) %>"
        data-paid="<%= paidCents %>"
        data-labels="<%= JSON.stringify({ estimate: t('Estimated total: {amount}'), beforeCoupon: t('(before coupon)'), free: t('Free'), paid: t('Already paid: {amount}'), due: t('Left to pay: {amount}'), nothingDue: t('Nothing more to pay') }) %>">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="from" value="ticket">
    <%- include('../partials/people-picker', { people, hasRsvp: true }) %>
    <%- include('../partials/guest-fields', { prices, rsvp, event }) %>
    <% if (event.fee_cents || event.guest_fee_cents) { %><p class="estimate" data-estimate style="margin:0"></p><% } %>
    <p class="muted small" style="margin:0"><%= t("Changing who's coming gives you a new QR code; the old one stops working.") %>
      <% if (event.fee_cents || event.guest_fee_cents) { %><%= t('Event fees are non-refundable, including if you reduce your number of guests.') %><% } %></p>
    <button class="btn big"><%= t('Save changes') %></button>
  </form>
</div>
<script src="<%= asset('/forms.js') %>"></script>
<% } else if (mine && !rsvp.checked_in_at && rsvp.status !== 'cancelled') { %>
  <p class="muted small" style="text-align:center"><%= t('RSVPs are closed for this event, so the ticket can no longer be changed.') %></p>
<% } %>
<%- include('../partials/foot') %>
