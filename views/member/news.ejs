<%- include('../partials/head') %>
<div class="page-head"><h1><%= t('News') %></h1></div>
<%- include('../partials/news-tabs') %>
<%- include('../partials/celebrations') %>
<% if (!posts.length) { %><div class="card"><p class="muted"><%= t('No announcements yet.') %></p></div><% } %>
<% for (const p of posts) { %>
  <article class="card">
    <h2 style="margin-bottom:4px"><%= loc(p, 'title') %></h2>
    <%# Announcements come from GSA as a whole, not the committee member who typed them. %>
    <p class="muted small" style="margin-top:0"><%= t('GSA Committee') %> · <%= fmtDay(p.created_at) %></p>
    <% if (p.image_path) { %><img src="<%= p.image_path %>" alt="" class="event-hero"><% } %>
    <div style="white-space:pre-line"><%= loc(p, 'body') %></div>
  </article>
<% } %>
<%- include('../partials/foot') %>
