<%- include('../partials/head') %>
<a class="back" href="/events">← <%= t('All events') %></a>
<% if (event.image_path) { %><img src="<%= event.image_path %>" alt="" class="event-hero"><% } %>
<div class="page-head">
  <h1><%= loc(event, 'title') %></h1>
  <% if (event.status === 'cancelled') { %><span class="badge err"><%= t('Cancelled') %></span><% } %>
</div>
<div class="grid grid-2">
  <div class="card">
    <p><strong><%= t('When:') %></strong> <%= fmtDate(event.starts_at) %><%# Same-day events show just the end time: "7:30 PM – 11:30 PM". %><%= event.ends_at ? ` – ${event.ends_at.slice(0, 10) === event.starts_at.slice(0, 10) ? fmtTime(event.ends_at) : fmtDate(event.ends_at)}` : '' %></p>
    <% if (event.location) { %><p><strong><%= t('Where:') %></strong> <%= event.location %>
      <a class="small" href="https://maps.google.com/?q=<%= encodeURIComponent(event.location.replace('|', ',')) %>" target="_blank" rel="noopener"><%= t('Directions') %></a></p><% } %>
    <p><strong><%= t('Price:') %></strong> <%- include('../partials/event-prices', { event }) %><%= event.fee_cents || event.guest_fee_cents ? ` (${t('non-refundable')})` : '' %></p>
    <% if (earlyBird) { %><p><span class="badge ok"><%= t('Early-bird price') %></span> <%= t('until {date}', { date: fmtDate(event.early_until) }) %></p><% } %>
    <% if (event.rsvp_deadline) { %><p><strong><%= t('RSVP by:') %></strong> <%= fmtDate(event.rsvp_deadline) %></p><% } %>
    <% if (spotsLeft !== null) { %><p><strong><%= t('Spots left:') %></strong> <%= spotsLeft %><%= spotsLeft === 0 ? ` — ${t('join the waitlist below')}` : '' %></p><% } %>
    <% if (loc(event, 'description')) { %><p style="white-space:pre-line"><%= loc(event, 'description') %></p><% } %>
    <a class="btn secondary small" href="/events/<%= event.id %>/calendar.ics">📅 <%= t('Add to my calendar') %></a>
    <% for (const a of albums) { %><a class="btn secondary small" href="/photos/albums/<%= a.id %>">📷 <%= t('Photos from this event') %></a><% } %>
  </div>

  <div class="card">
    <h2><%= t('Your RSVP') %></h2>
    <% if (rsvp) { %>
      <% const onTicket = people.filter((p) => p.chosen).map((p) => p.name); %>
      <p><%- include('../partials/rsvp-badge', { status: rsvp.status }) %> <%= plural(rsvp.party_size, '1 person', '{n} people') %><%= rsvp.guest_count ? ` (${plural(rsvp.guest_count, 'incl. 1 guest', 'incl. {n} guests')})` : '' %>
        <% if (onTicket.length) { %><br><span class="small"><%= onTicket.join(', ') %></span><% } %>
        <% if (rsvp.total_cents) { %><br><span class="muted small"><%= rsvp.discount_cents ? t('Total {total} after {discount} coupon discount', { total: money(rsvp.total_cents), discount: money(rsvp.discount_cents) }) : t('Total {total}', { total: money(rsvp.total_cents) }) %></span><% } %></p>
      <% if (rsvp.checked_in_at) { %>
        <p class="badge ok"><%= t('Checked in — {n} arrived', { n: rsvp.checked_in_count }) %></p>
      <% } else if (rsvp.status === 'confirmed') { %>
        <% if (due) { %><p class="pay-door-note">💵 <%= t('Please pay {amount} at the door (cash or check).', { amount: money(due) }) %></p><% } %>
        <a class="btn big" href="/tickets/<%= rsvp.id %>"><%= t('Show my QR ticket') %></a>
        <% if (due && paymentMode !== 'disabled') { %>
          <form method="post" action="/events/<%= event.id %>/pay" style="margin-top:8px"><%- include('../partials/csrf') %><button class="btn secondary small"><%= t('Pay {amount} online now instead', { amount: money(due) }) %></button></form>
        <% } %>
      <% } else if (rsvp.status === 'waitlisted') { %>
        <p class="muted"><%= rsvp.total_cents ? t("You're on the waitlist. If seats open up you'll be moved in automatically and can then pay.") : t("You're on the waitlist. If seats open up you'll be moved in automatically.") %></p>
      <% } else if (rsvp.status === 'pending_payment') { %>
        <p><%= t('Amount due:') %> <strong><%= money(due) %></strong>. <%= t('Your QR ticket will be ready once paid.') %></p>
        <% if (paymentMode !== 'disabled') { %>
          <form method="post" action="/events/<%= event.id %>/pay"><%- include('../partials/csrf') %><button class="btn big"><%= t('Pay {amount}', { amount: money(due) }) %></button></form>
        <% } %>
        <form method="post" action="/events/<%= event.id %>/pay-at-door" style="margin-top:8px"><%- include('../partials/csrf') %>
          <button class="btn secondary"><%= t('Pay at the door instead (cash or check)') %></button></form>
      <% } %>
    <% } %>

    <% if (open && !rsvp?.checked_in_at) { %>
      <% if (event.members_only && !membership.active) { %>
        <p class="muted"><%= t('This event is for members with an active membership.') %> <a href="/membership"><%= t('Pay membership') %></a></p>
      <% } else { %>
      <form method="post" action="/events/<%= event.id %>/rsvp" class="stack" style="margin-top:12px"
            data-price="<%= JSON.stringify(prices) %>"
            data-labels="<%= JSON.stringify({ estimate: t('Estimated total: {amount}'), beforeCoupon: t('(before coupon)'), free: t('Free') }) %>">
        <%- include('../partials/csrf') %>
        <%- include('../partials/people-picker', { people, hasRsvp: Boolean(rsvp) }) %>
        <%# A non-member coming themselves can say they're a student or from out of state (checked at the door). %>
        <% const me = people.find((p) => p.self && !p.member && p.canRegister && !p.taken); const gp = prices.guests; %>
        <% if (me && ('student' in gp || 'outofstate' in gp)) { %>
          <fieldset class="pay-choice self-type">
            <legend><%= t('You are coming as') %></legend>
            <label class="check"><input type="radio" name="self_type" value="" data-cents="<%= gp.instate %>" <%= me.rate === 'nonmember' ? 'checked' : '' %>> <span><%= t('In-state non-member') %> · <%= money(gp.instate) %></span></label>
            <% if ('outofstate' in gp) { %><label class="check"><input type="radio" name="self_type" value="outofstate" data-cents="<%= gp.outofstate %>" <%= me.rate === 'outofstate' ? 'checked' : '' %>> <span><%= t('Out-of-state visitor') %> · <%= money(gp.outofstate) %> <span class="muted small"><%= t('show an ID at the door') %></span></span></label><% } %>
            <% if ('student' in gp) { %><label class="check"><input type="radio" name="self_type" value="student" data-cents="<%= gp.student %>" <%= me.rate === 'student' ? 'checked' : '' %>> <span><%= t('Student') %> · <%= money(gp.student) %> <span class="muted small"><%= t('show your school ID at the door') %></span></span></label><% } %>
          </fieldset>
        <% } %>
        <%- include('../partials/guest-fields', { prices, rsvp, event }) %>
        <p class="muted small" style="margin:0"><%= t('Tick each family member who is coming. Only family on your profile and covered by your membership level can be registered.') %>
          <%= people.length > event.max_party_size ? t('Up to {n} people per RSVP.', { n: event.max_party_size }) : '' %>
          <%= event.guest_fee_cents !== null && !event.members_only ? t('Guests can come too.') : '' %>
          <% if (!isFamilyLogin) { %>
            <% if (!membership.active && familyListed) { %><a href="/membership"><%= t('Pay your membership') %></a> <%= t('to bring your family.') %>
            <% } else if (!membership.active) { %><a href="/membership"><%= t('Become a member') %></a> <%= t('and list your family to bring them.') %>
            <% } else if (people.length === 1 || people.some((p) => !p.canRegister)) { %><a href="/profile#family"><%= t('Add family members') %></a> <%= t('your level covers, or') %> <a href="/membership"><%= t('upgrade') %></a>.<% } %>
          <% } %>
          <% if (rsvp) { %><%= t("Changing who's coming gives you a new QR code; the old one stops working.") %><% } %>
          <% if (event.fee_cents || event.guest_fee_cents) { %><%= t('Event fees are non-refundable, including if you reduce your number of guests.') %><% } %></p>

        <% questions.forEach((q, i) => { %>
          <label><%= t.data(q.label) %><%= q.required ? ' *' : '' %>
            <% if (q.options.length) { %>
              <select name="q_<%= i %>" <%= q.required ? 'required' : '' %>><option value=""><%= t('Choose…') %></option>
                <% for (const o of q.options) { %><option value="<%= o %>" <%= answers[i]?.answer === o ? 'selected' : '' %>><%= t.data(o) %></option><% } %></select>
            <% } else { %><input name="q_<%= i %>" value="<%= answers[i]?.answer || '' %>" <%= q.required ? 'required' : '' %> maxlength="300"><% } %>
          </label>
        <% }) %>

        <% if (event.fee_cents || event.guest_fee_cents) { %>
          <label><%= t('Coupon code (optional)') %> <input name="coupon" value="" placeholder="<%= rsvp?.coupon_code || '' %>" autocapitalize="characters"></label>
          <p class="estimate" data-estimate style="margin:0"></p>
          <%# How to pay: card now, or cash/check at the door (the QR code comes straight away either way once settled). %>
          <% const door = rsvp ? Boolean(rsvp.pay_at_door) : paymentMode === 'disabled'; %>
          <fieldset class="pay-choice">
            <legend><%= t('How will you pay?') %></legend>
            <% if (paymentMode !== 'disabled') { %>
              <label class="check"><input type="radio" name="pay" value="online" <%= door ? '' : 'checked' %>> <span><strong><%= t('Pay online now') %></strong> <span class="muted small"><%= t('by card') %></span></span></label>
            <% } %>
            <label class="check"><input type="radio" name="pay" value="door" <%= door ? 'checked' : '' %>> <span><strong><%= t('Pay at the door') %></strong> <span class="muted small"><%= t('cash or check — you get your QR code now') %></span></span></label>
          </fieldset>
        <% } %>
        <% if (event.capacity) { %><label class="check"><input type="checkbox" name="waitlist" value="1" <%= spotsLeft === 0 ? 'checked' : '' %>> <%= t("If there isn't room, put me on the waitlist") %></label><% } %>
        <%# "RSVP & Pay" only when paying online; paying at the door is just "RSVP" (forms.js switches it as they choose). %>
        <% const paidEvent = event.fee_cents || event.guest_fee_cents; const doorChosen = rsvp ? Boolean(rsvp.pay_at_door) : paymentMode === 'disabled'; %>
        <button class="btn big <%= rsvp ? 'secondary' : '' %>"<% if (!rsvp && spotsLeft !== 0 && paidEvent) { %> data-label-online="<%= t('RSVP & Pay') %>" data-label-door="<%= t('RSVP') %>"<% } %>><%= rsvp ? t('Update RSVP') : spotsLeft === 0 ? t('Join waitlist') : (paidEvent && !doorChosen ? t('RSVP & Pay') : t('RSVP')) %></button>
      </form>
      <% } %>
      <% if (rsvp) { %>
        <form method="post" action="/events/<%= event.id %>/cancel" style="margin-top:12px" onsubmit="return confirm(<%= JSON.stringify(t('Cancel your RSVP?')) %>)">
          <%- include('../partials/csrf') %><button class="btn secondary small"><%= t('Cancel RSVP') %></button>
        </form>
      <% } %>
    <% } else if (!rsvp) { %>
      <p class="muted"><%= t('RSVPs are closed for this event.') %></p>
    <% } %>
  </div>
</div>
<script src="<%= asset('/forms.js') %>"></script>
<%- include('../partials/foot') %>
