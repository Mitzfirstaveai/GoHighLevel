<%- include('../partials/head') %>
<div class="page-head"><h1><%= t('My tickets') %></h1></div>
<% if (!tickets.length) { %>
  <div class="card"><p class="muted"><%= t("You don't have any upcoming tickets.") %></p><a class="btn" href="/events"><%= t('Browse events') %></a></div>
<% } %>
<div class="event-list">
<% for (const tk of tickets) { %>
  <div class="card event-item" style="margin:0">
    <%- include('../partials/date-chip', { when: tk.starts_at }) %>
    <div style="flex:1;min-width:0">
      <a href="/tickets/<%= tk.id %>" class="plain-link"><strong><%= loc(tk, 'title') %></strong></a> <%- include('../partials/rsvp-badge', { status: tk.status }) %>
      <div class="muted small"><%= fmtDate(tk.starts_at) %><%= tk.location ? ` · ${tk.location}` : '' %></div>
      <%- include('../partials/ticket-names', { tk }) %>
      <% if (!tk.mine) { %><div class="small muted"><%= t("{name}'s ticket", { name: `${tk.holder_first} ${tk.holder_last}` }) %></div><% } %>
      <div class="actions" style="margin-top:10px">
        <% if (tk.checked_in_at) { %><span class="badge ok"><%= t('Checked in') %></span>
        <% } else if (tk.status === 'confirmed') { %><a class="btn small" href="/tickets/<%= tk.id %>"><%= t('Show QR code') %></a>
        <% } else if (tk.status === 'pending_payment' && tk.mine) { %><a class="btn small" href="/events/<%= tk.event_id %>"><%= t('Complete payment') %></a>
        <% } else if (tk.status === 'waitlisted') { %><span class="muted small"><%= t('On the waitlist') %></span><% } %>
        <% if (tk.mine && !tk.checked_in_at) { %><a class="btn secondary small" href="/tickets/<%= tk.id %>#change"><%= t("Change who's coming") %></a><% } %>
      </div>
    </div>
  </div>
<% } %>
</div>
<%- include('../partials/foot') %>
