<%- include('../partials/head') %>
<div class="page-head"><h1>My payments</h1></div>
<div class="card">
  <% if (!payments.length) { %><p class="muted">No payments yet.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Date</th><th>Description</th><th>Method</th><th class="num">Amount</th></tr></thead>
    <tbody><% for (const p of payments) { %>
      <tr><td><%= fmtDate(p.paid_at.slice(0, 10)) %></td><td><%= p.description %></td><td><%= p.method %></td><td class="num"><%= money(p.amount_cents) %></td></tr>
    <% } %></tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
