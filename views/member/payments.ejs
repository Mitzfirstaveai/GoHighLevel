<%- include('../partials/head') %>
<div class="page-head"><h1><%= t('My payments') %></h1><a class="btn secondary" href="/donate"><%= t('Make a donation') %></a></div>
<div class="card">
  <% if (!payments.length) { %><p class="muted"><%= t('No payments yet.') %></p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th><%= t('Date') %></th><th><%= t('Description') %></th><th><%= t('Method') %></th><th class="num"><%= t('Amount') %></th><th></th></tr></thead>
    <tbody><% for (const p of payments) { %>
      <tr><td><%= fmtDate(p.paid_at.slice(0, 10)) %></td><td><%- include('../partials/payment-desc', { p }) %></td><td><%- include('../partials/payment-method', { method: p.method }) %></td><td class="num"><%= money(p.amount_cents) %></td><td class="num"><a href="/receipts/<%= p.id %>"><%= t('Receipt') %></a></td></tr>
    <% } %></tbody>
  </table></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
