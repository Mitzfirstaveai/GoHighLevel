<%- include('../partials/head') %>
<div class="page-head"><h1>Upcoming events</h1>
  <nav class="pills" style="margin:0"><a href="/events" class="active">List</a><a href="/events?view=calendar">Calendar</a></nav>
</div>
<% if (!events.length) { %><div class="card"><p class="muted">No upcoming events yet. Check back soon!</p></div><% } %>
<div class="event-list">
<% for (const e of events) { %>
  <a class="card event-item" href="/events/<%= e.id %>" style="margin:0">
    <%- include('../partials/date-chip', { when: e.starts_at }) %>
    <div style="flex:1">
      <strong><%= e.title %></strong>
      <% if (e.status === 'cancelled') { %><span class="badge err">Cancelled</span><% } %>
      <% if (e.my_status) { %><%- include('../partials/rsvp-badge', { status: e.my_status }) %><% } %>
      <% if (e.members_only) { %><span class="badge neutral">Members only</span><% } %>
      <div class="muted small"><%= fmtDate(e.starts_at) %><%= e.location ? ` · ${e.location}` : '' %></div>
      <div class="small"><%= e.fee_cents ? `${money(e.fee_cents)} per person` : 'Free' %></div>
    </div>
  </a>
<% } %>
</div>
<% if (past.length) { %>
<h2 style="margin-top:24px">Past events</h2>
<div class="card table-wrap"><table><tbody>
  <% for (const e of past) { %><tr><td class="muted" style="white-space:nowrap;width:1%"><%= fmtDate(e.starts_at.slice(0, 10)) %></td><td><%= e.title %></td></tr><% } %>
</tbody></table></div>
<% } %>
<%- include('../partials/foot') %>
