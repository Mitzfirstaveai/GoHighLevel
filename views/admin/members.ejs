<%- include('../partials/head') %>
<div class="page-head"><h1>Contacts (<%= members.length %>)</h1>
  <div class="actions">
    <a class="btn" href="/admin/members/new">+ Add contact</a>
    <a class="btn secondary" href="/admin/import">Import from spreadsheet</a>
    <a class="btn secondary" href="/admin/members.csv<%= exportQuery ? `?${exportQuery}` : '' %>">Download CSV</a>
  </div>
</div>
<form method="get" class="card filters">
  <input name="q" value="<%= filters.q %>" placeholder="Search name, email, phone, city, native place…" class="grow">
  <select name="status" aria-label="Membership status">
    <option value="">All contacts</option>
    <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active members</option>
    <option value="expired" <%= filters.status === 'expired' ? 'selected' : '' %>>Expired members</option>
    <option value="none" <%= filters.status === 'none' ? 'selected' : '' %>>Never a member</option>
  </select>
  <select name="level" aria-label="Membership level">
    <option value="">Any level</option>
    <% for (const p of plans) { %><option value="<%= p.id %>" <%= String(p.id) === filters.level ? 'selected' : '' %>><%= p.name %></option><% } %>
  </select>
  <select name="tag" aria-label="Tag">
    <option value="">Any tag</option>
    <% for (const t of tags) { %><option <%= t === filters.tag ? 'selected' : '' %>><%= t %></option><% } %>
  </select>
  <select name="city" aria-label="City">
    <option value="">Any city</option>
    <% for (const c of cities) { %><option <%= c === filters.city ? 'selected' : '' %>><%= c %></option><% } %>
  </select>
  <select name="login" aria-label="Login">
    <option value="">Login: any</option>
    <option value="yes" <%= filters.login === 'yes' ? 'selected' : '' %>>Has app login</option>
    <option value="no" <%= filters.login === 'no' ? 'selected' : '' %>>No login yet</option>
  </select>
  <button class="btn">Filter</button>
  <% if (exportQuery) { %><a href="/admin/members">Clear</a><% } %>
</form>
<div class="card table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Contact</th><th>City</th><th class="num">Family</th><th>Membership</th><th>Tags</th></tr></thead>
    <tbody>
    <% for (const m of members) { %>
      <tr>
        <td><a href="/admin/members/<%= m.id %>"><%= m.last_name %>, <%= m.first_name %></a><% if (m.role === 'admin') { %> <span class="badge neutral">Admin</span><% } %>
          <% if (m.native_place) { %><div class="muted small">Vatan: <%= m.native_place %></div><% } %></td>
        <td><%= m.email || '—' %><div class="muted small"><%= m.phone || '' %></div></td>
        <td><%= m.city || '' %></td>
        <td class="num"><%= m.household_count + 1 %></td>
        <td><% if (m.membership_end && m.membership_end >= today) { %><span class="badge ok"><%= m.level_name || 'Member' %></span><div class="muted small">until <%= fmtDate(m.membership_end) %></div>
            <% } else if (m.membership_end) { %><span class="badge err">Expired</span><div class="muted small"><%= fmtDate(m.membership_end) %></div><% } else { %><span class="badge neutral">None</span><% } %></td>
        <td><% for (const t of [...new Set([...m.tags.split(',').filter(Boolean), ...(m.is_donor ? ['Donor'] : [])])]) { %><span class="badge tag"><%= t %></span> <% } %>
          <% if (!m.password_hash) { %><span class="badge warn" title="Can't sign in to the app yet">No login</span><% } %></td>
      </tr>
    <% } %>
    <% if (!members.length) { %><tr><td colspan="6" class="muted">No contacts match these filters.</td></tr><% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/foot') %>
