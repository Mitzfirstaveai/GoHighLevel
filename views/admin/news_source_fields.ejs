<label>Name <input name="name" value="<%= s.name %>" required maxlength="100" placeholder="e.g. Divya Bhaskar: Gujarat"></label>
<label>Feed address <input name="url" type="url" value="<%= s.url %>" required maxlength="500" placeholder="https://…"></label>
<div class="grid grid-2" style="gap:12px">
  <label>Language <select name="lang">
    <% for (const [value, label] of [['gu', 'Gujarati'], ['en', 'English'], ['both', 'Both Gujarati and English']]) { %><option value="<%= value %>" <%= s.lang === value ? 'selected' : '' %>><%= label %></option><% } %>
  </select></label>
  <label>Topic <select name="topic"><% for (const tp of topics) { %><option <%= s.topic === tp ? 'selected' : '' %>><%= tp %></option><% } %></select></label>
</div>
