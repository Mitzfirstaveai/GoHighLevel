<%- include('../partials/head') %>
<a class="back" href="/admin/members">← Members</a>
<div class="page-head"><h1><%= member.first_name %> <%= member.last_name %></h1>
  <div class="actions"><% if (member.role === 'admin') { %><span class="badge neutral">Administrator</span><% } %><% if (member.checkin_access && member.role !== 'admin') { %><span class="badge neutral">Door volunteer</span><% } %>
  <% if (membership.active) { %><span class="badge ok">Member until <%= fmtDate(membership.current.end_date) %></span><% } else { %><span class="badge warn">No active membership</span><% } %></div>
</div>
<div class="card">
  <h2>Profile</h2>
  <p class="muted small"><%= member.password_hash ? 'Has app login' : 'No app login yet' %> · Added <%= fmtDay(member.created_at) %> · Last updated <%= fmtDay(member.updated_at) %></p>
  <form method="post" action="/admin/members/<%= member.id %>" class="stack">
    <%- include('../partials/csrf') %>
    <label>Email <input type="email" name="email" value="<%= member.email || '' %>"></label>
    <%- include('../partials/profile-fields', { p: member }) %>
    <fieldset class="tag-picker"><legend>Tags</legend>
      <% const mine = member.tags.split(','); for (const t of tags) { %><label class="check"><input type="checkbox" name="tags" value="<%= t %>" <%= mine.includes(t) ? 'checked' : '' %>> <%= t %></label><% } %>
    </fieldset>
    <label>Admin notes (not visible to member) <textarea name="notes"><%= member.notes || '' %></textarea></label>
    <div><button class="btn">Save changes</button></div>
  </form>
</div>

<div class="grid grid-2">
  <div class="card" id="family">
    <h2>Family members (<%= household.length %>)</h2>
    <% if (owner) { %><p class="flash info small">Family login — covered by <a href="/admin/members/<%= owner.id %>"><%= owner.first_name %> <%= owner.last_name %></a>'s membership. Their family is managed there.</p><% } %>
    <% if (coverage) { %><p class="small"><strong><%= membership.current.plan_name %></strong> covers <%= coverage %>.</p><% } %>
    <% if (coverageProblems.length) { %><p class="flash error small">More family listed than this level covers: <%= membership.current.plan_name %> <%= coverageProblems.join(', ') %>.</p><% } %>
    <% if (!household.length) { %><p class="muted">None listed.</p><% } %>
    <% for (const h of household) { %>
      <div class="actions" style="justify-content:space-between;border-bottom:1px solid var(--border);padding:6px 0">
        <span><%= h.name %><%= h.relationship ? ` — ${h.relationship}` : '' %><%= h.birth_year ? ` (born ${h.birth_month ? new Date(Date.UTC(h.birth_year, h.birth_month - 1, 1)).toLocaleString('en-US', { month: 'short', timeZone: 'UTC' }) + ' ' : ''}${h.birthday ? `${Number(h.birthday.slice(3))}, ` : ''}${h.birth_year})` : '' %>
          <% if (!(h.birth_year && h.birth_month)) { %><span class="badge warn">Birth month/year missing</span><% } %>
          <% if (h.login_user_id) { %><a class="badge ok" href="/admin/members/<%= h.login_user_id %>">Own login</a><% } else if (h.invite_token) { %><span class="badge neutral">Invite link created</span><% } %></span>
        <form method="post" action="/admin/members/<%= member.id %>/household/<%= h.id %>/delete" class="inline" onsubmit="return confirm('Remove <%= h.name %>?')"><%- include('../partials/csrf') %><button class="btn secondary small">Remove</button></form>
      </div>
      <%# Members can't change a saved birth month/year; the committee can correct it here. %>
      <details class="small" style="margin:4px 0 8px"><summary>Correct birth date</summary>
        <form method="post" action="/admin/members/<%= member.id %>/household/<%= h.id %>/birth" class="fields" style="margin-top:6px">
          <%- include('../partials/csrf') %>
          <%- include('../partials/birth-fields', { required: false, h }) %>
          <div style="align-self:end"><button class="btn secondary small">Save</button></div>
        </form>
      </details>
    <% } %>
    <form method="post" action="/admin/members/<%= member.id %>/household" class="actions" style="margin-top:10px">
      <%- include('../partials/csrf') %>
      <input name="name" placeholder="Name" required style="flex:2;min-width:140px">
      <select name="relationship" style="flex:1;min-width:120px"><% for (const r of relationships) { %><option><%= r %></option><% } %></select>
      <select name="birth_month" aria-label="Birth month" style="flex:1;min-width:110px"><option value="">Birth month</option><% for (let m = 1; m <= 12; m++) { %><option value="<%= m %>"><%= new Date(Date.UTC(2000, m - 1, 1)).toLocaleString('en-US', { month: 'long', timeZone: 'UTC' }) %></option><% } %></select>
      <select name="birth_day" aria-label="Day of birth (optional)" style="flex:0 1 90px;min-width:80px"><option value="">Day</option><% for (let d = 1; d <= 31; d++) { %><option value="<%= d %>"><%= d %></option><% } %></select>
      <input name="birth_year" placeholder="Birth year" inputmode="numeric" pattern="\d{4}" style="flex:1;min-width:100px">
      <button class="btn secondary small">Add</button>
    </form>
  </div>
  <div class="card">
    <h2>Record an in-person payment</h2>
    <form method="post" action="/admin/members/<%= member.id %>/payments" class="stack">
      <%- include('../partials/csrf') %>
      <div class="fields">
        <label>Type <select name="kind" onchange="this.form.plan_id.disabled = this.value !== 'membership'">
          <option value="membership">Membership dues</option><option value="donation">Donation</option><option value="other">Other fee</option></select></label>
        <label>Fund (donations) <select name="campaign_id"><option value="">General fund</option><% for (const c of campaigns) { %><option value="<%= c.id %>"><%= c.title %></option><% } %></select></label>
        <label>Plan <select name="plan_id"><% for (const p of plans) { %><option value="<%= p.id %>"><%= p.name %> (<%= money(p.amount_cents) %>)</option><% } %></select></label>
        <label>Amount (blank = plan price) <input name="amount" inputmode="decimal" placeholder="0.00"></label>
        <label>Description / note <input name="description"></label>
        <label>Method <select name="method"><option value="cash">Cash</option><option value="check">Check</option><option value="other">Other</option></select></label>
        <label>Check # / reference <input name="reference"></label>
      </div>
      <div><button class="btn secondary">Record payment</button></div>
    </form>
  </div>
</div>

<div class="card">
  <h2>Event RSVPs</h2>
  <% if (!rsvps.length) { %><p class="muted">None.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Event</th><th>Status</th><th class="num">People</th><th>Checked in</th></tr></thead>
    <tbody><% for (const r of rsvps) { %>
      <tr><td><a href="/admin/events/<%= r.event_id %>"><%= r.title %></a><div class="muted small"><%= fmtDate(r.starts_at) %></div></td>
        <td><%- include('../partials/rsvp-badge', { status: r.status }) %></td><td class="num"><%= r.party_size %></td>
        <td><%= r.checked_in_at ? `${r.checked_in_count} people` : '—' %></td></tr>
    <% } %></tbody>
  </table></div>
  <% } %>
</div>

<div class="card">
  <h2>Payments</h2>
  <% if (!payments.length) { %><p class="muted">None.</p><% } else { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Date</th><th>Description</th><th>Method</th><th class="num">Amount</th></tr></thead>
    <tbody><% for (const p of payments) { %><tr><td><%= fmtDay(p.paid_at) %></td><td><%= p.description %></td><td><%- include('../partials/payment-method', { method: p.method }) %><%= p.provider_ref ? ` (${p.provider_ref})` : '' %></td><td class="num"><%= money(p.amount_cents) %></td></tr><% } %></tbody>
  </table></div>
  <% } %>
</div>

<div class="card">
  <h2>Account</h2>
  <% if (member.role !== 'admin') { %>
    <p class="small"><strong>Door check-in:</strong> <%- member.checkin_access ? 'On — signs in at Committee &amp; volunteer sign-in to scan tickets and check families in (no access to contacts, payments or other admin pages).' : 'Off' %></p>
  <% } %>
  <div class="actions">
    <% if (member.role !== 'admin') { %>
    <form method="post" action="/admin/members/<%= member.id %>/checkin-access" class="inline"><%- include('../partials/csrf') %>
      <input type="hidden" name="access" value="<%= member.checkin_access ? '0' : '1' %>">
      <button class="btn secondary small"><%= member.checkin_access ? 'Turn off door check-in' : 'Make door volunteer' %></button></form>
    <% } %>
    <form method="post" action="/admin/members/<%= member.id %>/role" class="inline"><%- include('../partials/csrf') %>
      <input type="hidden" name="role" value="<%= member.role === 'admin' ? 'member' : 'admin' %>">
      <button class="btn secondary small" onclick="return confirm('Are you sure?')"><%= member.role === 'admin' ? 'Remove admin access' : 'Make administrator' %></button></form>
    <form method="post" action="/admin/members/<%= member.id %>/reset-password" class="inline"><%- include('../partials/csrf') %>
      <button class="btn secondary small" onclick="return confirm('Generate a temporary password for this member?')"><%= member.password_hash ? 'Reset password' : 'Create app login' %></button></form>
  </div>
</div>
<% if (!member.password_hash && member.role !== 'admin' && !member.owner_id) { %>
<div class="card">
  <h2>In the wrong list?</h2>
  <p class="muted small">If this is a business or organization (a sponsor or vendor) rather than a member, move it to Sponsors &amp; vendors.</p>
  <form method="post" action="/admin/members/<%= member.id %>/contact-type" onsubmit="return confirm('Move to Sponsors & vendors?')"><%- include('../partials/csrf') %>
    <input type="hidden" name="type" value="business"><button class="btn secondary small">Move to Sponsors &amp; vendors</button></form>
</div>
<% } %>
<%- include('../partials/foot') %>
