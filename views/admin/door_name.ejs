<%- include('../partials/head') %>
<%# The shared door login: the volunteer's first name, kept with every check-in and payment they record. %>
<div class="card" style="max-width:460px;margin:20px auto">
  <h1><%= t('Who is helping at the door?') %></h1>
  <p class="muted"><%= t('Type your first name. It is saved with each check-in and cash payment you record, so the committee knows who to ask.') %></p>
  <form method="post" action="/admin/checkin/name" class="stack">
    <%- include('../partials/csrf') %>
    <label><%= t('Your first name') %> <input name="name" value="<%= name %>" required maxlength="40" autocomplete="given-name" autocapitalize="words"></label>
    <button class="btn big"><%= t('Start checking in') %></button>
  </form>
</div>
<%- include('../partials/foot') %>
