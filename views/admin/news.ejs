<%- include('../partials/head') %>
<div class="page-head"><h1>News &amp; announcements</h1></div>
<div class="card">
  <h2>Post an announcement</h2>
  <form method="post" action="/admin/news?_csrf=<%= encodeURIComponent(csrf) %>" enctype="multipart/form-data" class="stack">
    <label>Title <input name="title" required placeholder="e.g. Navratri volunteers needed"></label>
    <label>Message <textarea name="body" required rows="6"></textarea></label>
    <details class="gu-fields"><summary>Gujarati version (optional)</summary>
      <div class="stack" lang="gu" style="margin-top:8px">
        <label>શીર્ષક (Title in Gujarati) <input name="title_gu"></label>
        <label>સંદેશ (Message in Gujarati) <textarea name="body_gu" rows="5"></textarea></label>
      </div>
    </details>
    <label>Photo (optional) <input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif"></label>
    <div><button class="btn">Post</button></div>
  </form>
</div>
<% for (const p of posts) { %>
  <div class="card">
    <div class="actions" style="justify-content:space-between">
      <div><strong><%= p.title %></strong> <span class="muted small">· <%= fmtDay(p.created_at) %></span></div>
      <form method="post" action="/admin/news/<%= p.id %>/delete" onsubmit="return confirm('Delete this announcement?')"><%- include('../partials/csrf') %><button class="btn secondary small">Delete</button></form>
    </div>
    <div class="muted" style="white-space:pre-line;margin-top:8px"><%= p.body %></div>
  </div>
<% } %>
<%- include('../partials/foot') %>
