<%- include('../partials/head') %>
<div class="page-head"><h1><%= t('Door check-in') %></h1></div>
<% if (locals.doorName) { %><p class="small door-who"><%= t('Helping at the door: {name}', { name: doorName }) %> · <a href="/admin/checkin/name"><%= t('Not you?') %></a></p><% } %>

<%# The camera comes first and fits the screen: at a busy door the volunteer shouldn't scroll. %>
<div class="card scanner-card" id="scanner">
  <div id="reader"></div>
  <p id="scan-status" class="muted"><%= t("Point the camera at a member's QR code.") %></p>
  <button id="start-btn" class="btn big"><%= t('Start camera') %></button>
  <label class="check quick-switch"><input type="checkbox" id="quick-mode" checked>
    <span><strong><%= t('Quick mode') %></strong> — <%= t('go back to the camera 3 seconds after each check-in') %></span></label>
</div>

<% if (events.length) { %>
  <nav class="pills wrap" aria-label="<%= t('Choose the event') %>">
    <% for (const e of events) { %>
      <a href="/admin/checkin?event=<%= e.id %>" class="<%= selected && e.id === selected.id ? 'active' : '' %>"><%= e.today ? t('Today') : fmtDate(e.starts_at.slice(0, 10)) %> · <%= loc(e, 'title') %></a>
    <% } %>
  </nav>
  <div class="stats">
    <div class="stat"><div class="label"><%= t('People checked in') %></div><div class="value"><%= selected.stats.checked_in_people %> <span class="muted small">/ <%= selected.stats.confirmed_people %></span></div>
      <div class="muted small"><%= t('{n} of {total} tickets scanned', { n: selected.stats.checked_in_parties, total: selected.stats.confirmed_parties }) %></div></div>
    <div class="stat"><div class="label"><%= t('Still to arrive') %></div><div class="value"><%= Math.max(0, selected.stats.confirmed_parties - selected.stats.checked_in_parties) %></div>
      <div class="muted small"><%= t('families') %></div></div>
  </div>
  <% if (!selected.today) { %><div class="flash info" role="status"><%= t('{event} is on {date}, not today. You can look people up, but tickets will show a warning until the day of the event.', { event: loc(selected, 'title'), date: fmtDate(selected.starts_at) }) %></div><% } %>
<% } else { %>
  <div class="flash info" role="status"><%= t('There are no events today or in the next 7 days.') %></div>
<% } %>


<% if (selected) { %>
<div class="card" id="find">
  <h2><%= t('No phone? Find the family by name') %></h2>
  <form method="get" action="/admin/checkin#find" class="actions">
    <input type="hidden" name="event" value="<%= selected.id %>">
    <input name="q" value="<%= q %>" placeholder="<%= t('Name or phone number') %>" aria-label="<%= t('Name or phone number') %>" style="flex:1;min-width:200px;font-size:1.15rem" minlength="2" required autocomplete="off">
    <button class="btn"><%= t('Search') %></button>
  </form>
  <% if (results) { %>
    <% if (!results.length) { %>
      <p class="muted"><%= t('No RSVP for {event} matches "{q}". Check the spelling, or try a family member\'s name or phone number.', { event: loc(selected, 'title'), q }) %></p>
    <% } %>
    <div class="menu-list">
    <% for (const r of results) { %>
      <a href="/admin/checkin/<%= r.qr_token %>">
        <span style="flex:1"><strong><%= r.first_name %> <%= r.last_name %></strong><% if (r.city) { %> <span class="muted small">· <%= r.city %></span><% } %><br>
          <span class="small"><%= r.names.length ? r.names.join(', ') + (r.guest_count ? ` + ${plural(r.guest_count, '1 guest', '{n} guests')}` : '') : plural(r.party_size, '1 person', '{n} people') %></span>
          <%- include('../partials/rsvp-badge', { status: r.status }) %>
          <% if (r.total_cents > r.paid_cents) { %><span class="badge warn">💵 <%= t('{amount} due', { amount: money(r.total_cents - r.paid_cents) }) %></span>
          <% } else if (r.total_cents) { %><span class="badge ok"><%= t('Paid') %></span><% } %>
          <% if (r.checked_in_at) { %><span class="badge neutral"><%= t('Arrived ({n})', { n: r.checked_in_count }) %></span><% } %></span>
        <span class="btn small <%= r.checked_in_at || r.status !== 'confirmed' ? 'secondary' : '' %>"><%= r.checked_in_at || r.status !== 'confirmed' ? t('View') : t('Check in') %></span>
      </a>
    <% } %>
    </div>
  <% } %>
</div>
<% } %>

<details class="card">
  <summary><strong><%= t('Type a ticket code instead') %></strong></summary>
  <form method="post" action="/admin/checkin/lookup" class="actions" style="margin-top:12px">
    <%- include('../partials/csrf') %>
    <input name="code" placeholder="<%= t('Ticket code, e.g. K7Q-3MX') %>" aria-label="<%= t('Ticket code') %>" style="flex:1;min-width:200px" required
      autocapitalize="characters" autocomplete="off" autocorrect="off" spellcheck="false">
    <button class="btn secondary"><%= t('Look up') %></button>
  </form>
  <p class="muted small"><%= t('The ticket code is printed under the QR code on the member\'s ticket.') %></p>
  <p class="muted small"><%= t("Tip: members' QR codes are links — you can also scan them with your phone's regular camera app while signed in here.") %></p>
</details>

<% if (adminMode) { %>
<div class="card stack" lang="en" id="door-login">
  <h2>Shared door login</h2>
  <p class="muted small" style="margin:0">One username and a simple password to give everyone helping at the door — no account needed. It opens only this
    check-in screen: volunteers see who has paid, take cash (or show the QR code so families pay on their own phone) and check people in.
    They can't see contact details, payment records or admin pages. Each person types their first name after signing in; it's saved with every
    check-in and cash payment.</p>
  <% if (doorLogin && doorLogin.checkin_access) { %>
    <p style="margin:0"><span class="badge ok">On</span> Sign in at <strong>Committee &amp; volunteer sign-in</strong> with username <code style="font-size:1.05rem">door</code> and the password you set.</p>
  <% } else { %>
    <p style="margin:0"><span class="badge neutral">Off</span> Set a password to turn it on.</p>
  <% } %>
  <form method="post" action="/admin/door-login" class="stack">
    <%- include('../partials/csrf') %>
    <label><%= doorLogin && doorLogin.checkin_access ? 'New password' : 'Password' %>
      <span class="pw-wrap"><input name="password" type="text" required minlength="4" maxlength="64" autocomplete="off" autocapitalize="none" spellcheck="false" data-door-password>
        <button type="button" class="pw-toggle" data-suggest-password>Suggest one</button></span></label>
    <p class="muted small" style="margin:0">Keep it short and easy to say out loud: 4 or more characters, e.g. <code>garba25</code>.
      <% if (doorLogin && doorLogin.checkin_access) { %>Changing it signs out every phone using the door login (do it after each event if you like).<% } %></p>
    <div class="actions">
      <button class="btn"><%= doorLogin && doorLogin.checkin_access ? 'Change password' : 'Turn on with this password' %></button>
    </div>
  </form>
  <% if (doorLogin && doorLogin.checkin_access) { %>
    <form method="post" action="/admin/door-login/off"><%- include('../partials/csrf') %><button class="btn secondary">Turn off the door login</button></form>
  <% } %>
</div>

<div class="card" lang="en">
  <h2>Door volunteers with their own login</h2>
  <p class="muted small">Volunteers sign in at <a href="/admin/login">Committee &amp; volunteer sign-in</a> (linked from the sign-in page) and see only this page.
    They can't see contact details, payments or other admin pages, and their member app doesn't show check-in.
    To add one, open their <a href="/admin/members">contact</a> and choose <strong>Make door volunteer</strong>.</p>
  <% if (volunteers.length) { %>
    <div class="actions">
    <% for (const v of volunteers) { %>
      <span class="badge neutral" style="font-size:.9rem;padding:6px 10px"><a href="/admin/members/<%= v.id %>"><%= v.first_name %> <%= v.last_name %></a>
        <form method="post" action="/admin/members/<%= v.id %>/checkin-access" class="inline"><%- include('../partials/csrf') %>
          <input type="hidden" name="access" value="0"><input type="hidden" name="return_to" value="/admin/checkin">
          <button class="linkish" title="Remove door access" aria-label="Remove door access for <%= v.first_name %> <%= v.last_name %>">✕</button></form></span>
    <% } %>
    </div>
  <% } else { %>
    <p class="muted">No door volunteers yet.</p>
  <% } %>
</div>
<% } %>
<script src="/vendor/html5-qrcode-2.3.8.min.js"></script>
<script src="<%= asset('/checkin.js') %>" data-msgs="<%= JSON.stringify({
  unavailable: t('Camera scanner could not load. Find the family by name or type the code instead.'),
  notTicket: t('That QR code is not a ticket.'),
  opening: t('Found ticket — opening…'),
  starting: t('Starting camera…'),
  ready: t("Point the camera at a member's QR code."),
  noCamera: t('Could not use the camera. Allow camera access, or find the family by name instead.'),
}) %>"></script>
<%- include('../partials/foot') %>
