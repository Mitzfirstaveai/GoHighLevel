<%- include('../partials/head') %>
<div class="card result">
  <% if (!rsvp && retired) { %>
    <div class="big-status err">⛔ <%= t('Old QR code — replaced') %></div>
    <p><%= t('{name} changed their RSVP for {event}, so this code no longer works.', { name: `${retired.first_name} ${retired.last_name}`, event: retired.event_title }) %></p>
    <p><%= retired.status === 'cancelled'
      ? t('Ask them to open My tickets in the app. Their RSVP is currently cancelled.')
      : retired.party_size === 1 ? t('Ask them to open My tickets in the app and show their latest QR code (now 1 person).')
      : t('Ask them to open My tickets in the app and show their latest QR code (now {n} people).', { n: retired.party_size }) %></p>
  <% } else if (!rsvp) { %>
    <div class="big-status err">❌ <%= t('Invalid QR code') %></div>
    <p><%= t('This code does not match any RSVP.') %></p>
  <% } else { %>
    <% if (rsvp.checked_in_at) { %>
      <div class="big-status <%= justCheckedIn ? 'ok' : 'err' %>">
        <%= justCheckedIn ? `✅ ${t('Checked in')}` : `⛔ ${t('Already used')}` %>
      </div>
      <p><%= rsvp.checker_first
        ? t('Checked in {time} by {by} — {n} of {total} people.', { time: fmtDate(rsvp.checked_in_at), by: `${rsvp.checker_first} ${rsvp.checker_last}`, n: rsvp.checked_in_count, total: rsvp.party_size })
        : t('Checked in {time} — {n} of {total} people.', { time: fmtDate(rsvp.checked_in_at), n: rsvp.checked_in_count, total: rsvp.party_size }) %></p>
    <% } else if (rsvp.status === 'cancelled') { %>
      <div class="big-status err">❌ <%= t('RSVP cancelled') %></div>
    <% } else if (rsvp.status === 'pending_payment') { %>
      <div class="big-status warn">⚠️ <%= t('Not paid yet') %></div>
    <% } else if (rsvp.status === 'waitlisted') { %>
      <div class="big-status warn">⏳ <%= t('On the waitlist — no seat yet') %></div>
      <p><%= t("This family joined the waitlist and hasn't been given a seat. Admit them only if there is room.") %></p>
    <% } else { %>
      <div class="big-status ok">✔ <%= t('Valid ticket') %></div>
    <% } %>

    <% if (notToday && !rsvp.checked_in_at) { %>
      <div class="flash error" role="alert"><%= t('Check the event: this ticket is for {event} on {date} — not today.', { event: eventTitle, date: fmtDate(rsvp.starts_at) }) %></div>
    <% } %>
    <h2 style="margin-bottom:0"><%= rsvp.first_name %> <%= rsvp.last_name %></h2>
    <p class="muted"><%= eventTitle %> · <%= fmtDate(rsvp.starts_at) %></p>
    <div class="party-count"><%= rsvp.party_size %></div>
    <p class="muted" style="margin-top:0"><%= rsvp.party_size === 1 ? t('person registered on this QR code') : t('people registered on this QR code') %><% if (rsvp.guest_count) { %> — <%= rsvp.guest_count === 1
      ? t('{family} family + 1 guest', { family: rsvp.party_size - rsvp.guest_count })
      : t('{family} family + {n} guests', { family: rsvp.party_size - rsvp.guest_count, n: rsvp.guest_count }) %><% } %></p>
    <% if (names.length) { %>
      <div class="ticket-for" style="text-align:left">
        <h3><%= t('Names on this ticket') %></h3>
        <ul>
          <% for (const name of names) { %><li><%= name %></li><% } %>
          <% if (rsvp.guest_count) { %><li class="muted"><%= plural(rsvp.guest_count, '1 guest', '{n} guests') %></li><% } %>
        </ul>
      </div>
    <% } %>

    <%# Payment, shown big: PAID (and how), or how much to collect — with buttons to record it. %>
    <% if (rsvp.total_cents && ['confirmed', 'pending_payment'].includes(rsvp.status)) { %>
      <% if (due) { %>
        <div class="pay-panel due">
          <div class="pay-big">💵 <%= t('{amount} DUE', { amount: money(due) }) %></div>
          <p style="margin:4px 0 10px"><%= rsvp.pay_at_door ? t('They chose to pay at the door. Collect it before checking them in.') : t('Not paid yet. Collect it before checking them in.') %></p>
          <form method="post" action="/admin/checkin/<%= token %>/payment" class="pay-buttons">
            <%- include('../partials/csrf') %>
            <span class="small"><%= t('Collected {amount} by:', { amount: money(due) }) %></span>
            <button class="btn" name="method" value="cash"><%= t('Cash') %></button>
            <button class="btn" name="method" value="check"><%= t('Check') %></button>
            <button class="btn secondary" name="method" value="other"><%= t('Other (card, Zelle…)') %></button>
          </form>
        </div>
      <% } else { %>
        <% const how = String(paid?.methods || '').split(',').filter(Boolean).map((m) => t({ stripe: 'online', demo: 'online', cash: 'cash', check: 'check', other: 'other' }[m] || m)).join(', '); %>
        <div class="pay-panel paid"><div class="pay-big">✔ <%= t('PAID') %></div>
          <p style="margin:4px 0 0"><%= how ? t('{amount} paid ({how})', { amount: money(paid.cents), how }) : t('{amount} paid', { amount: money(paid.cents) }) %></p></div>
      <% } %>
    <% } %>

    <% if (rsvp.status === 'confirmed' && !rsvp.checked_in_at) { %>
      <form method="post" action="/admin/checkin/<%= token %>" class="stack">
        <%- include('../partials/csrf') %>
        <label><%= t('How many people are arriving?') %>
          <select name="guests" style="font-size:1.3rem">
            <% for (let i = rsvp.party_size; i >= 1; i--) { %><option value="<%= i %>"><%= i %></option><% } %>
          </select>
        </label>
        <% if (due) { %>
          <button class="btn big secondary" onclick="return confirm(<%= JSON.stringify(t('They still owe {amount}. Check them in anyway?', { amount: money(due) })) %>)"><%= t('Check in without payment') %></button>
        <% } else { %>
          <button class="btn big ok"><%= t('Check in') %></button>
        <% } %>
      </form>
    <% } %>
  <% } %>
  <% const scanNext = `/admin/checkin${rsvp ? `?event=${rsvp.event_id}` : ''}#scanner`; %>
  <%# Quick mode: only after a successful check-in, never when something needs the volunteer's attention. %>
  <% if (rsvp && rsvp.checked_in_at && justCheckedIn) { %>
    <div class="auto-return" id="auto-return" data-url="<%= scanNext %>" data-template="<%= t('Back to the camera in {n} seconds…') %>" hidden>
      <p id="auto-return-text" style="margin:0 0 8px"></p>
      <button type="button" class="btn big secondary" id="auto-return-stay"><%= t('Stay on this page') %></button>
    </div>
  <% } %>
  <p style="margin-top:20px"><a class="btn big secondary" href="<%= scanNext %>"><%= t('Scan next') %></a></p>
</div>
<script src="<%= asset('/checkin-result.js') %>"></script>
<%- include('../partials/foot') %>
