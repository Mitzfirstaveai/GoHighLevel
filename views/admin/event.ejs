<%- include('../partials/head') %>
<a class="back" href="/admin/events">← All events</a>
<div class="page-head">
  <div><h1><%= event.title %></h1><div class="muted"><%= fmtDate(event.starts_at) %><%= event.location ? ` · ${event.location}` : '' %>
    <span class="badge <%= event.status === 'published' ? 'ok' : event.status === 'cancelled' ? 'err' : 'neutral' %>"><%= event.status %></span></div>
    <div class="small" style="margin-top:4px"><%- include('../partials/event-prices', { event }) %></div></div>
  <div class="actions">
    <a class="btn" href="/admin/checkin?event=<%= event.id %>">Door check-in</a>
    <a class="btn secondary" href="/admin/events/<%= event.id %>/edit">Edit</a>
    <a class="btn secondary" href="/admin/events/<%= event.id %>/attendees.csv">Download CSV</a>
  </div>
</div>
<div class="stats">
  <div class="stat"><div class="label">People attending (confirmed)</div><div class="value"><%= stats.confirmed_people %><%= event.capacity ? ` / ${event.capacity}` : '' %></div><div class="muted small"><%= stats.confirmed_parties %> RSVP<%= stats.confirmed_parties === 1 ? '' : 's' %><%= stats.confirmed_guests ? ` · incl. ${stats.confirmed_guests} guest${stats.confirmed_guests === 1 ? '' : 's'}` : '' %></div></div>
  <div class="stat"><div class="label">Awaiting payment</div><div class="value"><%= stats.pending_people %></div><div class="muted small"><%= stats.pending_parties %> RSVP<%= stats.pending_parties === 1 ? '' : 's' %></div></div>
  <div class="stat"><div class="label">Waitlist</div><div class="value"><%= stats.waitlisted_people %></div><div class="muted small"><%= stats.waitlisted_parties %> RSVP<%= stats.waitlisted_parties === 1 ? '' : 's' %> waiting</div></div>
  <div class="stat"><div class="label">Checked in</div><div class="value"><%= stats.checked_in_people %></div><div class="muted small"><%= stats.checked_in_parties %> of <%= stats.confirmed_parties %> QR codes scanned</div></div>
  <div class="stat"><div class="label">Fees collected</div><div class="value"><%= money(revenue) %></div></div>
</div>
<div class="card table-wrap">
  <h2>Guest list</h2>
  <table>
    <thead><tr><th>Member</th><th>Status</th><th class="num">Registered</th><th class="num">Paid</th><th>Check-in</th><th></th></tr></thead>
    <tbody>
    <% for (const a of attendees) { %>
      <tr class="<%= a.status === 'cancelled' ? 'dim' : '' %>">
        <td><a href="/admin/members/<%= a.user_id %>"><%= a.last_name %>, <%= a.first_name %></a><div class="muted small"><%= a.phone || a.email %></div>
          <% for (const ans of a.answers.filter((x) => x.answer)) { %><div class="small"><span class="muted"><%= ans.label %>:</span> <%= ans.answer %></div><% } %></td>
        <td><%- include('../partials/rsvp-badge', { status: a.status }) %></td>
        <td class="num"><strong><%= a.party_size %></strong><% if (a.guest_count) { %><div class="muted small">incl. <%= a.guest_count %> guest<%= a.guest_count === 1 ? '' : 's' %></div><% } %>
          <% if (a.names.length) { %><div class="small" style="text-align:right;max-width:220px;margin-left:auto"><%= a.names.join(', ') %></div><% } %></td>
        <td class="num"><%= a.total_cents || a.paid_cents ? money(a.paid_cents) : '—' %><% if (a.total_cents && a.paid_cents < a.total_cents && a.status !== 'cancelled') { %><div class="muted small">of <%= money(a.total_cents) %></div><% } %>
          <% if (a.coupon_code) { %><div class="small"><span class="badge tag"><%= a.coupon_code %></span></div><% } %></td>
        <td><% if (a.checked_in_at) { %><span class="badge ok"><%= a.checked_in_count %> arrived</span><div class="muted small"><%= fmtDate(a.checked_in_at) %></div><% } else { %>—<% } %></td>
        <td class="num">
          <% if (a.status === 'pending_payment') { %>
            <form method="post" action="/admin/rsvps/<%= a.id %>/record-payment" class="inline" onsubmit="return confirm('Record a cash payment for this RSVP?')">
              <%- include('../partials/csrf') %><input type="hidden" name="method" value="cash"><button class="btn secondary small">Record cash</button></form>
          <% } else if (a.status === 'confirmed' && !a.checked_in_at) { %>
            <a class="btn secondary small" href="/admin/checkin/<%= a.qr_token %>">Check in</a>
          <% } %>
        </td>
      </tr>
    <% } %>
    <% if (!attendees.length) { %><tr><td colspan="6" class="muted">No RSVPs yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="card" id="coupons">
  <h2>Coupon codes</h2>
  <% if (coupons.length) { %>
  <div class="table-wrap"><table>
    <thead><tr><th>Code</th><th>Discount</th><th class="num">Used</th><th>Expires</th><th></th></tr></thead>
    <tbody><% for (const c of coupons) { %>
      <tr class="<%= c.active ? '' : 'dim' %>"><td><strong><%= c.code %></strong></td>
        <td><%= c.percent_off ? `${c.percent_off}% off` : `${money(c.amount_off_cents)} off` %></td>
        <td class="num"><%= c.uses %><%= c.max_uses ? ` / ${c.max_uses}` : '' %></td>
        <td><%= c.expires_at ? fmtDate(c.expires_at) : '—' %></td>
        <td class="num"><form method="post" action="/admin/coupons/<%= c.id %>/toggle" class="inline"><%- include('../partials/csrf') %><button class="btn secondary small"><%= c.active ? 'Turn off' : 'Turn on' %></button></form></td></tr>
    <% } %></tbody>
  </table></div>
  <% } else { %><p class="muted">No coupon codes for this event yet.</p><% } %>
  <form method="post" action="/admin/events/<%= event.id %>/coupons" class="filters" style="margin-top:10px">
    <%- include('../partials/csrf') %>
    <input name="code" placeholder="CODE e.g. GARBA10" required>
    <select name="kind"><option value="percent">% off</option><option value="amount">$ off</option></select>
    <input name="value" placeholder="10" inputmode="decimal" required>
    <input name="max_uses" type="number" min="1" placeholder="Max uses (optional)">
    <input name="expires_at" type="date" title="Expires (optional)">
    <button class="btn secondary">Add coupon</button>
  </form>
</div>
<%- include('../partials/foot') %>
