# Copy to .env and fill in.
PORT=3000
# Public URL of the site — used in QR codes and Stripe redirects.
BASE_URL=http://localhost:3000
ORG_NAME=Gujarati Samaj of Arkansas
# Time zone events are entered in (affects "upcoming" and RSVP deadlines).
TZ=America/Chicago
CURRENCY=usd
# Long random string, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=
DATABASE_FILE=./data/samaj.db

# First administrator account (created at startup if it doesn't exist).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe (https://dashboard.stripe.com/apikeys). Leave blank to use demo payments locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Demo site: sample data, one-tap demo sign-in and a "Reset demo data" button for admins.
DEMO_MODE=false
# Demo payments are on by default outside production when Stripe isn't configured.
# ALLOW_DEMO_PAYMENTS=false
